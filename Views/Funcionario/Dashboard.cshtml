@{
    ViewData["Title"] = "Employee Dashboard";
}
@section Styles {
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
}


<div class="dashboard-container">

    <h1 class="dashboard-title">Dashboard de Funcionário</h1>

    <div class="dashboard-grid">

        <!-- Editar contentor -->
        <a asp-controller="Containers" asp-action="ListStatus" class="dashboard-card">
            <i class="fa-solid fa-book dashboard-icon"></i>
            <span>Alterar Estado Contentor</span>
        </a>

        <!-- Consultar contentores -->
        <a asp-controller="Containers" asp-action="List" class="dashboard-card">
            <i class="fa-solid fa-magnifying-glass dashboard-icon"></i>
            <span>Consultar Contentores</span>
        </a>

        <!-- Consultar Rota -->
        <a asp-controller="Funcionario" asp-action="Dashboard" class="dashboard-card">
            <i class="fa-solid fa-route dashboard-icon"></i>
            <span>Consultar Rota</span>
        </a>

        <!-- Estado de Recolha -->
        <a asp-controller="Funcionario" asp-action="Dashboard" class="dashboard-card">
            <i class="fa-solid fa-clock dashboard-icon"></i>
            <span>Estado de Recolha</span>
        </a>
    </div>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js"></script>
}
