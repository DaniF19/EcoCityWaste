@model EcoCityWaste.ViewModels.ContainerEditViewModel

@{
    ViewData["Title"] = "Editar Contentor";
}

@section Styles {
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
}

<div class="page-container">
    <div class="card-box" style="max-width: 800px; margin: 0 auto;">

        <div class="card-title"
             style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; border-bottom: 1px solid #f0ebe3; padding-bottom: 20px;">

            <span style="margin:0; font-size:1.5rem; font-weight:bold; color:#8d6e63; display: flex; align-items: center;">
                Editar Contentor (@Model.Code)
                <span data-bs-toggle="tooltip" data-bs-placement="right" title="Mantenha os dados físicos (tipo e morada) atualizados caso o contentor seja movido ou substituído." style="cursor: help; color: #bcaaa4; margin-left: 10px; font-size: 1.2rem;">
                    <i class="fa-solid fa-circle-info"></i>
                </span>
            </span>

            <a asp-controller="Containers" asp-action="List" class="btn-vista-analitica">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </a>

        </div>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Code" /> <div style="margin-bottom: 25px;">
                <label style="font-weight: 700; color: #795c4d; font-size: 0.85rem; text-transform: uppercase; margin-bottom: 8px; display: flex; align-items: center; letter-spacing: 0.5px;">
                    Localização (Morada)
                </label>
                <div class="input-group" style="position: relative;">
                    <i class="fa-solid fa-location-dot input-icon" style="position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: #888;"></i>
                    <input asp-for="Location" placeholder="Localização" style="width: 100%; padding: 12px 20px 12px 50px; border-radius: 50px; border: 1px solid #ccc; font-size: 1rem;" />
                </div>
                <span asp-validation-for="Location" class="field-error" style="color: red; font-size: 0.85rem; margin-top: 5px; display: block;"></span>
            </div>

            <div style="margin-bottom: 25px;">
                <label class="field-label" style="font-weight: 700; color: #795c4d; font-size: 0.85rem; text-transform: uppercase; margin-bottom: 8px; display: block; letter-spacing: 0.5px;">
                    Tipo de Resíduo
                </label>
                <div class="selection-grid">
                    <label class="selection-item">
                        <input type="radio" asp-for="Type" value="Plástico" />
                        <div class="selection-content"><i class="fa-solid fa-bottle-water"></i><span>Plástico</span></div>
                    </label>
                    <label class="selection-item">
                        <input type="radio" asp-for="Type" value="Vidro" />
                        <div class="selection-content"><i class="fa-solid fa-wine-glass-empty"></i><span>Vidro</span></div>
                    </label>
                    <label class="selection-item">
                        <input type="radio" asp-for="Type" value="Papel" />
                        <div class="selection-content"><i class="fa-solid fa-box-archive"></i><span>Papel</span></div>
                    </label>
                    <label class="selection-item">
                        <input type="radio" asp-for="Type" value="Orgânico" />
                        <div class="selection-content"><i class="fa-solid fa-apple-whole"></i><span>Orgânico</span></div>
                    </label>
                    <label class="selection-item">
                        <input type="radio" asp-for="Type" value="Indiferenciado" />
                        <div class="selection-content"><i class="fa-solid fa-trash-can"></i><span>Indiferenciado</span></div>
                    </label>
                </div>
                <span asp-validation-for="Type" class="field-error" style="color: red; font-size: 0.85rem; display: block; margin-top: 5px;"></span>
            </div>

            <label class="field-label">Estado Atual</label>
            <div class="selection-grid">

                <label class="selection-item">
                    <input type="radio" asp-for="Status" value="Good" />
                    <div class="selection-content">
                        <i class="fa-solid fa-thumbs-up"></i>
                        <span>Bom</span>
                    </div>
                </label>

                <label class="selection-item">
                    <input type="radio" asp-for="Status" value="Maintenance" />
                    <div class="selection-content">
                        <i class="fa-solid fa-screwdriver-wrench"></i>
                        <span>Manutenção</span>
                    </div>
                </label>

                <label class="selection-item">
                    <input type="radio" asp-for="Status" value="Broken" />
                    <div class="selection-content">
                        <i class="fa-solid fa-xmark"></i>
                        <span>Avariado</span>
                    </div>
                </label>

            </div>

            <button type="submit" class="btn-primary" style="margin-top: 20px; width: 100%; padding: 15px; border-radius: 50px; font-size: 1.1rem; border: none;">
                <i class="fa-solid fa-floppy-disk me-2"></i> Guardar Alterações
            </button>
        </form>
    </div>
</div>