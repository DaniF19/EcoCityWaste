@model EcoCityWaste.ViewModels.ContainerEditViewModel

@{
    ViewData["Title"] = "Editar Contentor";
}

@section Styles {
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
}

<div class="page-container">

    <div class="card-box">

        <div class="card-title"
             style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">

            <span style="margin:0; font-size:1.5rem; font-weight:bold; color:#8d6e63;">
                Editar Contentor
            </span>

            <a asp-controller="Containers" asp-action="List" class="btn-vista-analitica">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </a>

        </div>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div class="input-group">
                <i class="fa-solid fa-location-dot input-icon"></i>
                <input asp-for="Location" class="eco-input" placeholder="Localização" />
                <span asp-validation-for="Location" class="field-error"></span>
            </div>

            <label class="field-label">Tipo de Contentor</label>
            <div class="selection-grid">
                <label class="selection-item">
                    <input type="radio" asp-for="Type" value="Plástico" />
                    <div class="selection-content">
                        <i class="fa-solid fa-bottle-water"></i>
                        <span>Plástico</span>
                    </div>
                </label>
                <label class="selection-item">
                    <input type="radio" asp-for="Type" value="Vidro" />
                    <div class="selection-content">
                        <i class="fa-solid fa-wine-glass-empty"></i>
                        <span>Vidro</span>
                    </div>
                </label>
                <label class="selection-item">
                    <input type="radio" asp-for="Type" value="Papel" />
                    <div class="selection-content">
                        <i class="fa-solid fa-box-archive"></i>
                        <span>Papel</span>
                    </div>
                </label>
                <label class="selection-item">
                    <input type="radio" asp-for="Type" value="Orgânico" />
                    <div class="selection-content">
                        <i class="fa-solid fa-apple-whole"></i>
                        <span>Orgânico</span>
                    </div>
                </label>
                <label class="selection-item">
                    <input type="radio" asp-for="Type" value="Indiferenciado" />
                    <div class="selection-content">
                        <i class="fa-solid fa-trash-can"></i>
                        <span>Indiferenciado</span>
                    </div>
                </label>
            </div>
            <span asp-validation-for="Type" class="field-error"></span>

            <label class="field-label">Estado Atual</label>
            <div class="selection-grid">

                <label class="selection-item">
                    <input type="radio" asp-for="Status" value="Good" />
                    <div class="selection-content">
                        <i class="fa-solid fa-thumbs-up"></i>
                        <span>Bom</span>
                    </div>
                </label>

                <label class="selection-item">
                    <input type="radio" asp-for="Status" value="Full" />
                    <div class="selection-content">
                        <i class="fa-solid fa-circle-up"></i>
                        <span>Cheio</span>
                    </div>
                </label>

                <label class="selection-item">
                    <input type="radio" asp-for="Status" value="Empty" />
                    <div class="selection-content">
                        <i class="fa-solid fa-circle-down"></i>
                        <span>Vazio</span>
                    </div>
                </label>

                <label class="selection-item">
                    <input type="radio" asp-for="Status" value="Maintenance" />
                    <div class="selection-content">
                        <i class="fa-solid fa-screwdriver-wrench"></i>
                        <span>Manutenção</span>
                    </div>
                </label>

                <label class="selection-item">
                    <input type="radio" asp-for="Status" value="Broken" />
                    <div class="selection-content">
                        <i class="fa-solid fa-xmark"></i>
                        <span>Avariado</span>
                    </div>
                </label>

            </div>
            <span asp-validation-for="Status" class="field-error"></span>


            <button type="submit" class="btn-primary" style="margin-top: 30px;">
                Guardar Alterações
            </button>

        </form>

    </div>

</div>