@model EcoCityWaste.Dtos.UpdateContainerStatusDto
@using System.ComponentModel.DataAnnotations
@using EcoCityWaste.Models

@{
    ViewData["Title"] = "Atualizar Estado";
}

@section Styles {
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
}

<div class="page-container">

    <div class="card-box">

        <div class="card-title">
            Atualizar Estado do Contentor
        </div>

        <div class="field-label" style="margin-bottom: 10px;">
            Contentor ID: @Model.Id
        </div>

        <div class="field-label" style="margin-bottom: 10px;">
            Estado atual: @Model.Status
        </div>

        <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()

            <label class="field-label">Novo Estado</label>

            <div class="selection-grid">
                @foreach (var value in Enum.GetValues(typeof(Container.ContainerStatus)))
                {
                    var enumValue = (Container.ContainerStatus)value;

                    var display = enumValue
                    .GetType()
                    .GetMember(enumValue.ToString())[0]
                    .GetCustomAttributes(typeof(DisplayAttribute), false)
                    .Cast<DisplayAttribute>()
                    .FirstOrDefault()?.Name
                    ?? enumValue.ToString();

                    <label class="selection-item">
                        <input type="radio" asp-for="Status" value="@display" />
                        <div class="selection-content">
                            <span>@display</span>
                        </div>
                    </label>
                }
            </div>

            <button type="submit" class="btn-primary" style="margin-top: 30px;">
                Guardar Estado
            </button>

        </form>

    </div>

</div>
