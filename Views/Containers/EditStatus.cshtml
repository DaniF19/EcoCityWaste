@model EcoCityWaste.Dtos.UpdateContainerStatusDto
@{
    ViewData["Title"] = "Atualizar Estado";
}

@section Styles {
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
}

<div class="page-container">
    <div class="card-box">
        <div class="card-title">
            Atualizar Estado do Contentor
        </div>

        <div class="field-label" style="margin-bottom: 20px;">
            Contentor ID: @Model.Id | Estado atual: <strong>@Model.Status</strong>
        </div>

        <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />

            <label class="field-label">Selecione o novo estado</label>
            <div class="selection-grid">
                <label class="selection-item">
                    <input type="radio" asp-for="Status" value="Full" />
                    <div class="selection-content">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>Cheio</span>
                    </div>
                </label>

                <label class="selection-item">
                    <input type="radio" asp-for="Status" value="Empty" />
                    <div class="selection-content">
                        <i class="fa-solid fa-trash"></i>
                        <span>Vazio</span>
                    </div>
                </label>

                <label class="selection-item">
                    <input type="radio" asp-for="Status" value="Good" />
                    <div class="selection-content">
                        <i class="fa-solid fa-thumbs-up"></i>
                        <span>Bom</span>
                    </div>
                </label>

                <label class="selection-item">
                    <input type="radio" asp-for="Status" value="Broken" />
                    <div class="selection-content">
                        <i class="fa-solid fa-xmark"></i>
                        <span>Avariado</span>
                    </div>
                </label>

                <label class="selection-item">
                    <input type="radio" asp-for="Status" value="Maintenance" />
                    <div class="selection-content">
                        <i class="fa-solid fa-screwdriver-wrench"></i>
                        <span>Manutenção</span>
                    </div>
                </label>
            </div>
            <span asp-validation-for="Status" class="field-error"></span>

            <button type="submit" class="btn-primary" style="margin-top: 30px;">
                Atualizar Estado
            </button>
        </form>
    </div>
</div>