@model IEnumerable<EcoCityWaste.Models.ContainerStatusHistory>

@{
    ViewData["Title"] = "Histórico do Contentor";
}

@section Styles {
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
}

<div class="page-container">

    <div class="card-box">

        <div class="card-title">
            Histórico do Contentor
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Estado</th>
                    <th>Nível (%)</th>
                    <th>Ativo</th>
                    <th>Alterado por</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ChangedAt.ToString("dd/MM/yyyy HH:mm")</td>

                        <td>@item.Status</td>

                        <td>@item.FillLevel%</td>

                        <td>
                            @(item.IsActive ? "Sim" : "Não")
                        </td>

                        <td>@item.ChangedBy</td>
                    </tr>
                }

            </tbody>
        </table>

    </div>

</div>