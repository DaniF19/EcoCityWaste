@model IEnumerable<EcoCityWaste.Models.ContainerStatusHistory>

@{
    ViewData["Title"] = "Histórico do Contentor";
}

@section Styles {
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
}

<div class="page-container">

    <div class="card-box">

        <div class="card-title"
             style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">

            <span style="margin:0; font-size:1.5rem; font-weight:bold; color:#8d6e63;">
                Histórico Contentor
            </span>

            <a asp-controller="Containers" asp-action="List" class="btn-vista-analitica">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </a>

        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Estado</th>
                    <th>Nível (%)</th>
                    <th>Ativo</th>
                    <th>Alterado por</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ChangedAt.ToString("dd/MM/yyyy HH:mm")</td>

                        <td>@item.Status</td>

                        <td>@item.FillLevel%</td>

                        <td>
                            @(item.IsActive ? "Sim" : "Não")
                        </td>

                        <td>@item.ChangedBy</td>
                    </tr>
                }

            </tbody>
        </table>

    </div>

</div>