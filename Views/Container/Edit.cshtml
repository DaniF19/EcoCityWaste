@model EcoCityWaste.Models.Container

@{
    ViewData["Title"] = "Editar Contentor";
}

@section Styles {
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
}

<div class="page-container">

    <div class="card-box">

        <div class="card-title">
            Editar Contentor
        </div>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div class="input-group">
                <i class="fa-solid fa-location-dot input-icon"></i>
                <input asp-for="Location" placeholder="Localização" />
                <span asp-validation-for="Location" class="field-error"></span>
            </div>

            <div class="input-group">
                <i class="fa-solid fa-recycle input-icon"></i>
                <select asp-for="Type">
                    <option>Plástico</option>
                    <option>Vidro</option>
                    <option>Papel</option>
                    <option>Orgânico</option>
                </select>
                <span asp-validation-for="Type" class="field-error"></span>
            </div>

            <div class="input-group">
                <i class="fa-solid fa-box-open input-icon"></i>
                <select asp-for="Status">
                    <option>Vazio</option>
                    <option>Parcial</option>
                    <option>Cheio</option>
                </select>
                <span asp-validation-for="Status" class="field-error"></span>
            </div>

            <button type="submit" class="btn-primary">
                Guardar Alterações
            </button>

        </form>

    </div>

</div>
