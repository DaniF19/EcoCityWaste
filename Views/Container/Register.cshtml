@model EcoCityWaste.Models.ContainerRegisterViewModel

@{
    ViewData["Title"] = "Registar Contentor";
}
@section Styles {
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
}

<div class="page-container">

    <div class="card-box">

        <div class="card-title">
            Registar Contentor
        </div>

        @if (ViewBag.Success != null)
        {
            <div class="alert-success-addcontainer">
                @ViewBag.Success
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert-error">
                @ViewBag.Error
            </div>
        }

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div class="input-group">
                <i class="fa-solid fa-location-dot input-icon"></i>
                <input asp-for="Location" placeholder="Localização" />
                <span asp-validation-for="Location" class="field-error"></span>
            </div>

            <label class="field-label">Tipo de Contentor</label>
            <div class="selection-grid">
                <label class="selection-item">
                    <input type="radio" asp-for="Type" value="Plástico" />
                    <div class="selection-content">
                        <i class="fa-solid fa-recycle"></i>
                        <span>Plástico</span>
                    </div>
                </label>
                <label class="selection-item">
                    <input type="radio" asp-for="Type" value="Vidro" />
                    <div class="selection-content">
                        <i class="fa-solid fa-wine-glass"></i>
                        <span>Vidro</span>
                    </div>
                </label>
                <label class="selection-item">
                    <input type="radio" asp-for="Type" value="Papel" />
                    <div class="selection-content">
                        <i class="fa-solid fa-note-sticky"></i>
                        <span>Papel</span>
                    </div>
                </label>
                <label class="selection-item">
                    <input type="radio" asp-for="Type" value="Orgânico" />
                    <div class="selection-content">
                        <i class="fa-solid fa-apple-whole"></i>
                        <span>Orgânico</span>
                    </div>
                </label>
            </div>
            <span asp-validation-for="Type" class="field-error"></span>

            <label class="field-label">Estado Inicial</label>
            <div class="selection-grid">
                <label class="selection-item">
                    <input type="radio" asp-for="Status" value="Vazio" />
                    <div class="selection-content">
                        <i class="fa-solid fa-battery-empty"></i>
                        <span>Vazio</span>
                    </div>
                </label>
                <label class="selection-item">
                    <input type="radio" asp-for="Status" value="Parcial" />
                    <div class="selection-content">
                        <i class="fa-solid fa-battery-half"></i>
                        <span>Parcial</span>
                    </div>
                </label>
                <label class="selection-item">
                    <input type="radio" asp-for="Status" value="Cheio" />
                    <div class="selection-content">
                        <i class="fa-solid fa-battery-full"></i>
                        <span>Cheio</span>
                    </div>
                </label>
            </div>
            <span asp-validation-for="Status" class="field-error"></span>

            <button type="submit" class="btn-primary" style="margin-top: 20px;">
                Registar
            </button>
        </form>

    </div>

</div>
