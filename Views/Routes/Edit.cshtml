@model EcoCityWaste.Models.ViewModels.RouteEditViewModel
@using EcoCityWaste.Models
@{
    ViewData["Title"] = "Editar Rota";
    var containers = ViewBag.Containers as List<Container> ?? new List<Container>();
    // Pre-selected IDs in order
    var preselected = Model.ContainerIds ?? new List<int>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <style>
        /* Reuse exact same styles as Create.cshtml */
        :root {
            --blue: #3b82f6; --green: #22c55e; --amber: #f59e0b; --red: #ef4444;
            --s2: #1e293b; --s3: #334155; --border: rgba(255,255,255,.07);
            --text: #f1f5f9; --muted: #94a3b8;
        }
        .create-grid { display: grid; grid-template-columns: 1fr 420px; gap: 24px; align-items: start; }
        @@media(max-width:900px) { .create-grid { grid-template-columns: 1fr; } }
        .panel { background: var(--s2); border: 1px solid var(--border); border-radius: 14px; padding: 24px; }
        .panel-title { font-size: 1rem; font-weight: 700; color: var(--text); margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }
        .panel-title i { color: var(--amber); }
        .field-group { margin-bottom: 18px; }
        .field-group label { display: block; font-size: .8rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-bottom: 7px; }
        .field-group input, .field-group textarea { width: 100%; background: var(--s3); border: 1px solid var(--border); border-radius: 9px; padding: 10px 14px; color: var(--text); font-size: .9rem; outline: none; transition: border-color .15s; box-sizing: border-box; }
        .field-group input:focus, .field-group textarea:focus { border-color: var(--amber); }
        .field-error { font-size: .78rem; color: var(--red); margin-top: 4px; display: block; }
        .search-input { width: 100%; background: var(--s3); border: 1px solid var(--border); border-radius: 9px; padding: 9px 14px; color: var(--text); font-size: .85rem; outline: none; margin-bottom: 12px; box-sizing: border-box; }
        .search-input:focus { border-color: var(--amber); }
        .container-pool { max-height: 380px; overflow-y: auto; display: flex; flex-direction: column; gap: 7px; }
        .container-pool::-webkit-scrollbar { width: 5px; }
        .container-pool::-webkit-scrollbar-thumb { background: var(--s3); border-radius: 4px; }
        .pool-item { display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: var(--s3); border: 1px solid var(--border); border-radius: 9px; cursor: pointer; transition: border-color .12s, background .12s; user-select: none; }
        .pool-item:hover { border-color: var(--amber); background: rgba(245,158,11,.07); }
        .pool-item.selected { border-color: var(--amber); background: rgba(245,158,11,.1); opacity: .45; pointer-events: none; }
        .pool-item-info { display: flex; flex-direction: column; gap: 2px; }
        .pool-item-code { font-family: monospace; font-size: .78rem; color: var(--amber); background: rgba(245,158,11,.1); padding: 2px 7px; border-radius: 4px; display: inline-block; margin-bottom: 2px; }
        .pool-item-loc { font-size: .82rem; color: var(--text); }
        .fill-pill { font-size: .75rem; font-weight: 700; padding: 3px 9px; border-radius: 12px; }
        .fill-low  { background: rgba(34,197,94,.15);  color: var(--green); }
        .fill-mid  { background: rgba(245,158,11,.15); color: var(--amber); }
        .fill-high { background: rgba(239,68,68,.15);  color: var(--red); }
        .route-order-list { min-height: 120px; max-height: 400px; overflow-y: auto; display: flex; flex-direction: column; gap: 7px; }
        .route-order-list::-webkit-scrollbar { width: 5px; }
        .route-order-list::-webkit-scrollbar-thumb { background: var(--s3); border-radius: 4px; }
        .order-item { display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: var(--s3); border: 1px solid var(--border); border-radius: 9px; cursor: grab; transition: box-shadow .12s; }
        .order-item:active { cursor: grabbing; }
        .order-item.dragging { opacity: .5; box-shadow: 0 8px 24px rgba(0,0,0,.4); }
        .order-item.drag-over { border-color: var(--amber); background: rgba(245,158,11,.1); }
        .order-num { width: 26px; height: 26px; border-radius: 50%; background: var(--amber); color: #000; font-size: .75rem; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .order-info { flex: 1; min-width: 0; }
        .order-code { font-size: .78rem; color: var(--amber); font-family: monospace; }
        .order-loc  { font-size: .82rem; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .order-remove { width: 26px; height: 26px; border-radius: 6px; border: 1px solid var(--border); background: transparent; color: var(--muted); cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: .78rem; transition: all .12s; }
        .order-remove:hover { background: var(--red); border-color: var(--red); color: #fff; }
        .btn-submit { width: 100%; padding: 13px; border-radius: 10px; border: none; background: var(--amber); color: #000; font-size: .95rem; font-weight: 700; cursor: pointer; margin-top: 20px; transition: opacity .15s; }
        .btn-submit:hover { opacity: .85; }
        .counter-badge { display: inline-flex; align-items: center; justify-content: center; min-width: 22px; height: 22px; border-radius: 11px; background: var(--amber); color: #000; font-size: .72rem; font-weight: 700; padding: 0 6px; }
        .tip { background: rgba(245,158,11,.08); border: 1px solid rgba(245,158,11,.2); border-radius: 9px; padding: 10px 14px; font-size: .8rem; color: var(--muted); margin-bottom: 14px; }
        .tip i { color: var(--amber); margin-right: 5px; }
    </style>
}

<div class="page-container">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">
        <a asp-action="Details" asp-route-id="@Model.Id" style="color:var(--muted);text-decoration:none;font-size:.88rem;">
            <i class="fa-solid fa-chevron-left"></i> Rota
        </a>
        <h1 style="font-size:1.5rem;font-weight:700;color:var(--text);margin:0;">
            <i class="fa-solid fa-pen" style="color:var(--amber);"></i> Editar Rota
        </h1>
    </div>

    <form id="editForm" asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div id="hiddenInputs"></div>

        <div class="create-grid">
            <div>
                <div class="panel" style="margin-bottom:20px;">
                    <div class="panel-title"><i class="fa-solid fa-pen-to-square"></i> Informações</div>
                    <div class="field-group">
                        <label>Nome da Rota *</label>
                        <input asp-for="Name" />
                        <span asp-validation-for="Name" class="field-error"></span>
                    </div>
                    <div class="field-group">
                        <label>Descrição</label>
                        <textarea asp-for="Description" rows="3"></textarea>
                    </div>
                </div>
                <div class="panel">
                    <div class="panel-title">
                        <i class="fa-solid fa-trash-can"></i>
                        Contentores Disponíveis
                        <span class="counter-badge" id="availCount">@containers.Count</span>
                    </div>
                    <input type="text" class="search-input" id="searchPool" placeholder="Pesquisar…" />
                    <div class="container-pool" id="containerPool">
                        @foreach (var c in containers)
                        {
                            var fillClass = c.FillLevel >= 80 ? "fill-high" : c.FillLevel >= 50 ? "fill-mid" : "fill-low";
                            <div class="pool-item" data-id="@c.Id" data-code="@c.Code" data-loc="@c.Location" data-fill="@c.FillLevel" onclick="addToRoute(this)">
                                <div class="pool-item-info">
                                    <span class="pool-item-code">@c.Code</span>
                                    <span class="pool-item-loc">@c.Location</span>
                                </div>
                                <span class="fill-pill @fillClass">@c.FillLevel%</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div>
                <div class="panel" style="position:sticky;top:20px;">
                    <div class="panel-title">
                        <i class="fa-solid fa-list-ol"></i>
                        Ordem de Recolha
                        <span class="counter-badge" id="routeCount">0</span>
                    </div>
                    <div class="tip">
                        <i class="fa-solid fa-circle-info"></i>
                        Clique para adicionar. Arraste para reordenar.
                    </div>
                    <span id="containerIdsError" class="field-error" style="display:none;margin-bottom:10px;">
                        Selecione pelo menos um contentor.
                    </span>
                    <div class="route-order-list" id="routeOrderList">
                        <div class="empty-order" id="emptyOrder" style="text-align:center;padding:30px;color:var(--muted);font-size:.85rem;border:1.5px dashed var(--border);border-radius:9px;">
                            <i class="fa-solid fa-arrow-left" style="margin-right:5px;"></i> Adicione contentores
                        </div>
                    </div>
                    <button type="submit" class="btn-submit" id="submitBtn">
                        <i class="fa-solid fa-floppy-disk" style="margin-right:6px;"></i>
                        Guardar Alterações
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Pre-populate from server
        const preselected = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(preselected));
        const selectedIds = [];

        window.addEventListener('DOMContentLoaded', () => {
            preselected.forEach(id => {
                const el = document.querySelector(`.pool-item[data-id="${id}"]`);
                if (el) addToRoute(el);
            });
        });

        function addToRoute(el) {
            const id = el.dataset.id;
            if (selectedIds.includes(id)) return;
            selectedIds.push(id);
            el.classList.add('selected');
            renderOrder();
        }

        function removeFromRoute(id) {
            const idx = selectedIds.indexOf(id);
            if (idx === -1) return;
            selectedIds.splice(idx, 1);
            const poolItem = document.querySelector(`.pool-item[data-id="${id}"]`);
            if (poolItem) poolItem.classList.remove('selected');
            renderOrder();
        }

        function renderOrder() {
            const list    = document.getElementById('routeOrderList');
            const counter = document.getElementById('routeCount');
            const hidden  = document.getElementById('hiddenInputs');
            counter.textContent = selectedIds.length;
            hidden.innerHTML = '';
            if (selectedIds.length === 0) {
                list.innerHTML = '';
                list.appendChild(document.getElementById('emptyOrder') || (() => {
                    const d = document.createElement('div');
                    d.id = 'emptyOrder';
                    d.style.cssText = 'text-align:center;padding:30px;color:var(--muted);font-size:.85rem;border:1.5px dashed var(--border);border-radius:9px;';
                    d.innerHTML = '<i class="fa-solid fa-arrow-left" style="margin-right:5px;"></i> Adicione contentores';
                    return d;
                })());
                return;
            }
            list.innerHTML = '';
            selectedIds.forEach((id, i) => {
                const poolItem = document.querySelector(`.pool-item[data-id="${id}"]`);
                const code = poolItem?.dataset.code || id;
                const loc  = poolItem?.dataset.loc  || '';
                const fill = parseInt(poolItem?.dataset.fill || 0);
                const fillCls = fill >= 80 ? 'fill-high' : fill >= 50 ? 'fill-mid' : 'fill-low';
                const item = document.createElement('div');
                item.className = 'order-item';
                item.draggable = true;
                item.dataset.id = id;
                item.innerHTML = `
                    <div class="order-num">${i + 1}</div>
                    <div class="order-info">
                        <div class="order-code">${code}</div>
                        <div class="order-loc">${loc}</div>
                    </div>
                    <span class="fill-pill ${fillCls}" style="font-size:.72rem;padding:2px 7px;">${fill}%</span>
                    <button type="button" class="order-remove" onclick="removeFromRoute('${id}')">
                        <i class="fa-solid fa-xmark"></i>
                    </button>`;
                item.addEventListener('dragstart', e => { e.dataTransfer.setData('text/plain', id); item.classList.add('dragging'); });
                item.addEventListener('dragend', () => item.classList.remove('dragging'));
                item.addEventListener('dragover', e => { e.preventDefault(); item.classList.add('drag-over'); });
                item.addEventListener('dragleave', () => item.classList.remove('drag-over'));
                item.addEventListener('drop', e => {
                    e.preventDefault(); item.classList.remove('drag-over');
                    const draggedId = e.dataTransfer.getData('text/plain');
                    const fromIdx = selectedIds.indexOf(draggedId);
                    const toIdx = i;
                    if (fromIdx === toIdx) return;
                    selectedIds.splice(fromIdx, 1);
                    selectedIds.splice(toIdx, 0, draggedId);
                    renderOrder();
                });
                list.appendChild(item);
                const inp = document.createElement('input');
                inp.type = 'hidden'; inp.name = 'ContainerIds'; inp.value = id;
                hidden.appendChild(inp);
            });
        }

        document.getElementById('searchPool').addEventListener('input', function () {
            const q = this.value.toLowerCase();
            document.querySelectorAll('.pool-item').forEach(el => {
                el.style.display = (el.dataset.code.toLowerCase().includes(q) || el.dataset.loc.toLowerCase().includes(q)) ? '' : 'none';
            });
        });

        document.getElementById('editForm').addEventListener('submit', function (e) {
            const errEl = document.getElementById('containerIdsError');
            if (selectedIds.length === 0) { e.preventDefault(); errEl.style.display = 'block'; } else { errEl.style.display = 'none'; }
        });
    </script>
}
