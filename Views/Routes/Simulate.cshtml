@using EcoCityWaste.Models
@model EcoCityWaste.Models.Route
@{
    ViewData["Title"] = "Simulação - " + Model.Code;
}

<h2>Simulação da rota @Model.Code</h2>

<div id="map" style="height: 500px; border-radius: 8px;"></div>

<div class="mt-3 d-flex gap-2 align-items-center">
    <button id="btnStart" class="btn btn-success">▶ Iniciar simulação</button>
    <button id="btnReset" class="btn btn-secondary" disabled>↺ Reiniciar</button>
    <span id="statusMsg" class="text-muted ms-2"></span>
</div>

@section Scripts {
    <!-- Leaflet CSS + JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <!-- SignalR -->
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>

    <script>
        const routeId = @Model.Id;

        // --- Mapa ---
        const map = L.map('map').setView([38.716, -9.139], 13); // Lisboa como centro inicial
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        // --- Ícones ---
        const iconPending   = L.divIcon({ className: '', html: '<div style="background:#3B82F6;color:#fff;border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;font-weight:bold;border:2px solid #1D4ED8">🗑</div>', iconSize: [32,32], iconAnchor: [16,16] });
        const iconCollected = L.divIcon({ className: '', html: '<div style="background:#22C55E;color:#fff;border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;font-weight:bold;border:2px solid #16A34A">✓</div>',  iconSize: [32,32], iconAnchor: [16,16] });
        const iconTruck     = L.divIcon({ className: '', html: '<div style="font-size:28px;filter:drop-shadow(0 1px 2px rgba(0,0,0,.4))">🚛</div>', iconSize: [36,36], iconAnchor: [18,18] });

        // --- Estado ---
        let containers = [];
        let markers    = [];
        let truckMarker = null;
        let routeLine   = null;
        let simInterval = null;
        let currentStep = 0;

        // --- SignalR ---
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/simulationHub")
            .build();

        connection.on("RouteLoaded", (data) => {
            containers = data;
            setupMap(data);
            document.getElementById('btnStart').disabled = false;
            setStatus(`${data.length} contentores carregados. Pronto!`);
        });

        connection.start().then(() => {
            connection.invoke("StartSimulation", routeId);
            setStatus("A carregar rota...");
        });

        function setupMap(data) {
            // Limpar
            markers.forEach(m => map.removeLayer(m));
            if (truckMarker) map.removeLayer(truckMarker);
            if (routeLine)   map.removeLayer(routeLine);
            markers = [];

            const latlngs = data.map(c => [c.lat, c.lng]);

            // Linha da rota
            routeLine = L.polyline(latlngs, { color: '#6366F1', weight: 3, dashArray: '8 5', opacity: 0.7 }).addTo(map);

            // Marcadores dos contentores
            data.forEach(c => {
                const m = L.marker([c.lat, c.lng], { icon: iconPending })
                    .bindPopup(`<b>${c.code}</b><br>Nível: ${c.fillLevel}%<br>Ordem: ${c.order}º`)
                    .addTo(map);
                markers.push(m);
            });

            // Camião no primeiro contentor
            truckMarker = L.marker([data[0].lat, data[0].lng], { icon: iconTruck })
                .bindPopup('🚛 Camião de recolha')
                .addTo(map);

            map.fitBounds(routeLine.getBounds(), { padding: [40, 40] });
        }

        // --- Simulação passo a passo ---
        document.getElementById('btnStart').addEventListener('click', () => {
            if (containers.length === 0) return;

            document.getElementById('btnStart').disabled = true;
            document.getElementById('btnReset').disabled = false;
            currentStep = 0;
            runStep();
        });

        function runStep() {
            if (currentStep >= containers.length) {
                setStatus('✅ Rota concluída!');
                return;
            }

            const c = containers[currentStep];
            setStatus(`🚛 A recolher contentor ${c.code} (${currentStep + 1}/${containers.length})...`);

            // Move camião para este contentor
            truckMarker.setLatLng([c.lat, c.lng]);
            map.panTo([c.lat, c.lng], { animate: true, duration: 0.8 });

            // Aguarda um momento e marca como recolhido
            setTimeout(() => {
                markers[currentStep].setIcon(iconCollected);
                currentStep++;
                setTimeout(runStep, 1200); // pausa entre contentores
            }, 1500);
        }

        document.getElementById('btnReset').addEventListener('click', () => {
            clearInterval(simInterval);
            currentStep = 0;
            setupMap(containers);
            document.getElementById('btnStart').disabled = false;
            setStatus('Simulação reiniciada.');
        });

        function setStatus(msg) {
            document.getElementById('statusMsg').textContent = msg;
        }
    </script>
}