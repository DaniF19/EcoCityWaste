@model EcoCityWaste.Models.ViewModels.OptimisedRouteDto
@using EcoCityWaste.Models
@{
    ViewData["Title"] = "Optimizar Rota";
    var route = ViewBag.Route as Route;
}

<style>

:root{
    --cor-castanho: rgb(141,110,99);
    --cor-bege: rgb(224,205,169);
    --cor-fundo-claro: rgb(243,242,235);

    --cor-sucesso:#27ae60;
    --cor-aviso:#f1c40f;
    --cor-vermelho-erro:#a94442;
    --cor-manutencao:#3498db;

    --border:#e6e6e6;
    --text:#444;
    --muted:#777;

    --surface:#ffffff;
    --surface-2:#ffffff;
    --surface-3:#f7f6f2;
}

.optimise-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:24px;
    flex-wrap:wrap;
    gap:12px;
}


.info-banner{
    background: #f3ebe8;
    border: 1px solid var(--cor-bege);
    border-radius: 9px;
    padding: 10px 14px;
    font-size: .8rem;
    color: var(--muted);
    margin-bottom: 14px;
}

.info-banner i{
    color:var(--cor-castanho);
    font-size:1.2rem;
}

.info-banner p{
    margin:0;
    color:var(--text);
    font-size:.88rem;
    line-height:1.5;
}

.info-banner strong{
    color:var(--cor-castanho);
}


.optimise-grid{
    display:grid;
    grid-template-columns:1fr 300px;
    gap:20px;
    align-items:start;
}

@@media(max-width:820px){
    .optimise-grid{grid-template-columns:1fr;}
}


.panel{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:14px;
    padding:22px;
    box-shadow:0 4px 15px rgba(0,0,0,0.03);
}

.panel-title{
    font-size:.95rem;
    font-weight:700;
    color:var(--cor-castanho);
    margin-bottom:18px;
    display:flex;
    align-items:center;
    gap:8px;
}

.panel-title i{
    color:var(--cor-castanho);
}


.opt-stop{
    display:flex;
    align-items:center;
    gap:12px;
    padding:12px 14px;
    border-radius:10px;
    background:var(--surface-3);
    border:1px solid var(--border);
    margin-bottom:8px;
}

.opt-stop:last-child{
    margin-bottom:0;
}

.opt-num{
    width:30px;
    height:30px;
    border-radius:50%;
    background:var(--cor-castanho);
    color:white;
    font-size:.8rem;
    font-weight:700;
    display:flex;
    align-items:center;
    justify-content:center;
}

.opt-info{
    flex:1;
    min-width:0;
}

.opt-code{
    font-family:monospace;
    font-size:.78rem;
    color:var(--cor-castanho);
    background:#f3ebe8;
    padding:2px 7px;
    border-radius:4px;
    margin-right:6px;
}

.opt-loc{
    font-size:.85rem;
    color:var(--text);
    margin-top:2px;
}


.fill-pill{
    font-size:.75rem;
    font-weight:700;
    padding:3px 9px;
    border-radius:12px;
}

.fill-low{
    background:#d4edda;
    color:var(--cor-sucesso);
}

.fill-mid{
    background:#fff3cd;
    color:var(--cor-aviso);
}

.fill-high{
    background:#f8d7da;
    color:var(--cor-vermelho-erro);
}

.high-fill-badge{
    font-size:.7rem;
    font-weight:700;
    padding:2px 7px;
    border-radius:10px;
    background:#f8d7da;
    color:var(--cor-vermelho-erro);
    border:1px solid #f1b0b7;
}


.summary-row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:10px 0;
    border-bottom:1px solid var(--border);
    font-size:.87rem;
}

.summary-row:last-child{
    border-bottom:none;
}

.summary-label{
    color:var(--muted);
}

.summary-value{
    color:var(--text);
    font-weight:600;
}


.btn-apply{
    width:100%;
    padding:13px;
    border-radius:10px;
    border:none;
    background:var(--cor-castanho);
    color:white;
    font-size:.95rem;
    font-weight:700;
    cursor:pointer;
    margin-top:18px;
}

.btn-apply:hover{
    opacity:.9;
}

.btn-cancel{
    display:block;
    width:100%;
    padding:11px;
    border-radius:10px;
    border:1px solid var(--border);
    background:white;
    color:var(--muted);
    font-size:.87rem;
    font-weight:600;
    text-align:center;
    text-decoration:none;
    margin-top:8px;
}

.btn-cancel:hover{
    color:var(--text);
    border-color:var(--cor-castanho);
}

.arrow-indicator{
    display:flex;
    align-items:center;
    gap:6px;
    font-size:.78rem;
    color:var(--muted);
    margin:4px 0 4px 44px;
}

</style>

<div class="page-container">
    <div style="margin-bottom:16px;">
        <a asp-action="Details" asp-route-id="@route?.Id"
               style="text-decoration:none;color: white;background: var(--cor-castanho);border-radius: 8px;border: 1px solid rgba(255, 255, 255, .1);gap: 6px;padding: 7px 14px;font-size: .82rem;text-decoration: none;">
            <i class="fa-solid fa-chevron-left"></i> Voltar à Rota
        </a>
    </div>

    <div class="optimise-header">
        <div>
            <h1 style="font-size:1.5rem;font-weight:800;color:var(--cor-castanho);margin:0 0 4px 0; display: flex; align-items: center;">
                <i class="fa-solid fa-wand-magic-sparkles" style="color:var(--cor-castanho);margin-right:8px;"></i>
                Optimização de Rota Inteligente
                <span data-bs-toggle="tooltip" title="A otimização refaz o percurso para minimizar a distância total, priorizando sempre os contentores mais cheios." style="cursor: help; color: #bcaaa4; margin-left: 12px; font-size: 1.1rem;">
                    <i class="fa-solid fa-circle-info"></i>
                </span>
            </h1>
            <p style="color:var(--muted);margin:0;font-size:.88rem; font-weight: 600;">
                @route?.Code – @route?.Name
            </p>
        </div>
    </div>

    <div class="info-banner" style="display: flex; align-items: flex-start; gap: 15px; border-left: 4px solid var(--cor-castanho); background: #fffcf5;">
        <i class="fa-solid fa-microchip" style="color: var(--cor-castanho); font-size: 1.8rem; margin-top: 5px;"></i>
        <p style="color: #555;">
            O nosso algoritmo analisou as coordenadas GPS e o nível de lixo atual.<br>
            Contentores com um nível de enchimento <strong>≥ 80% foram colocados no início da rota</strong> para evitar transbordo, e a distância de condução foi minimizada para <strong>poupar combustível</strong>. Reveja a nova ordem abaixo antes de aplicar.
        </p>
    </div>

    <div class="optimise-grid">
        <div class="panel">
            <div class="panel-title">
                <i class="fa-solid fa-route"></i>
                Percurso Sugerido (@Model.Stops.Count paragens)
            </div>

            @for (int i = 0; i < Model.Stops.Count; i++)
            {
                var s = Model.Stops[i];
                var fillClass = s.FillLevel >= 80 ? "fill-high" : s.FillLevel >= 50 ? "fill-mid" : "fill-low";
                <div class="opt-stop">
                    <div class="opt-num">@s.PickupOrder</div>
                    <div class="opt-info">
                        <div>
                            <span class="opt-code">@s.Code</span>
                            @if (s.FillLevel >= 80)
                            {
                                <span class="high-fill-badge" data-bs-toggle="tooltip" title="Priorizado devido ao nível de lixo elevado.">
                                    <i class="fa-solid fa-fire"></i> Crítico
                                </span>
                            }
                        </div>
                        <div class="opt-loc" style="font-weight: 600;">@s.Location</div>
                        @if (s.Latitude == 0 && s.Longitude == 0)
                        {
                            <div style="font-size:.75rem;color:#f1c40f;margin-top:4px;">
                                <i class="fa-solid fa-triangle-exclamation"></i> Sem GPS (foi ordenado para o fim)
                            </div>
                        }
                    </div>
                    <span class="fill-pill @fillClass">@s.FillLevel%</span>
                </div>

                @if (i < Model.Stops.Count - 1)
                {
                    <div class="arrow-indicator">
                        <i class="fa-solid fa-arrow-down" style="color: #ccc;"></i>
                    </div>
                }
            }
        </div>

        <div>
            <div class="panel" style="position: sticky; top: 20px;">
                <div class="panel-title" style="margin-bottom:14px; border-bottom: 1px solid var(--border); padding-bottom: 10px;">
                    <i class="fa-solid fa-chart-pie"></i> Resumo da Análise
                </div>

                <div class="summary-row">
                    <span class="summary-label">Total de Paragens</span>
                    <span class="summary-value">@Model.Stops.Count</span>
                </div>
                <div class="summary-row" data-bs-toggle="tooltip" data-bs-placement="left" title="Distância estimada com base na rede rodoviária real.">
                    <span class="summary-label">Distância Prevista</span>
                    <span class="summary-value" style="color: black;">@Model.EstimatedDistanceKm km</span>
                </div>
                <div class="summary-row">
                    <span class="summary-label">Paragens Críticas</span>
                    <span class="summary-value" style="color:var(--cor-vermelho-erro);">
                        @Model.Stops.Count(s => s.FillLevel >= 80)
                    </span>
                </div>
                <div class="summary-row">
                    <span class="summary-label">Ignorados (Sem GPS)</span>
                    <span class="summary-value" style="color:var(--cor-aviso);">
                        @Model.Stops.Count(s => s.Latitude == 0 && s.Longitude == 0)
                    </span>
                </div>

                <form asp-action="ApplyOptimisation" method="post" id="apply-optimisation-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="routeId" value="@route?.Id" />
                    @foreach (var s in Model.Stops)
                    {
                        <input type="hidden" name="orderedContainerIds" value="@s.ContainerId" />
                    }
                    <button type="button" class="btn-apply" onclick="confirmOptimisation()" style="border-radius: 10px;">
                        <i class="fa-solid fa-check me-2"></i> Gravar Nova Ordem
                    </button>
                </form>

                <a asp-action="Details" asp-route-id="@route?.Id" class="btn-cancel" style="border-radius: 10px; margin-top: 10px;">
                    Cancelar Optimização
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    function confirmOptimisation() {
        Swal.fire({
            title: 'Aplicar Optimização?',
            text: "A nova ordem de paragens será guardada nesta rota.",
            icon: 'question',
            iconColor: 'rgb(141, 110, 99)',
            showCancelButton: true,
            confirmButtonColor: 'rgb(141, 110, 99)',
            cancelButtonColor: '#777',
            confirmButtonText: 'Sim, aplicar',
            cancelButtonText: 'Cancelar',
            borderRadius: '15px'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('apply-optimisation-form').submit();
            }
        })
    }
</script>
