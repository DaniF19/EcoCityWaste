@model EcoCityWaste.Models.ViewModels.OptimisedRouteDto
@using EcoCityWaste.Models
@{
    ViewData["Title"] = "Optimizar Rota";
    var route = ViewBag.Route as Route;
}

@section Styles {
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <style>
        :root {
            --blue: #3b82f6; --green: #22c55e; --amber: #f59e0b;
            --red: #ef4444; --cyan: #06b6d4;
            --s2: #1e293b; --s3: #334155; --border: rgba(255,255,255,.07);
            --text: #f1f5f9; --muted: #94a3b8;
        }

        .optimise-header {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 24px; flex-wrap: wrap; gap: 12px;
        }

        .info-banner {
            background: linear-gradient(135deg, rgba(6,182,212,.12), rgba(59,130,246,.08));
            border: 1px solid rgba(6,182,212,.25);
            border-radius: 12px;
            padding: 16px 20px;
            margin-bottom: 24px;
            display: flex; gap: 14px; align-items: flex-start;
        }

        .info-banner i { color: var(--cyan); font-size: 1.2rem; flex-shrink: 0; margin-top: 2px; }

        .info-banner p { margin: 0; color: var(--text); font-size: .88rem; line-height: 1.5; }
        .info-banner strong { color: var(--cyan); }

        .optimise-grid {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 20px;
            align-items: start;
        }

        @@media(max-width:820px) { .optimise-grid { grid-template-columns: 1fr; } }

        .panel {
            background: var(--s2);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 22px;
        }

        .panel-title {
            font-size: .95rem; font-weight: 700; color: var(--text);
            margin-bottom: 18px; display: flex; align-items: center; gap: 8px;
        }

        .panel-title i { color: var(--cyan); }

        /* ── Stops ── */
        .opt-stop {
            display: flex; align-items: center; gap: 12px;
            padding: 12px 14px; border-radius: 10px;
            background: var(--s3); border: 1px solid var(--border);
            margin-bottom: 8px; position: relative;
        }

        .opt-stop:last-child { margin-bottom: 0; }

        .opt-num {
            width: 30px; height: 30px; border-radius: 50%;
            background: var(--cyan); color: #fff;
            font-size: .8rem; font-weight: 700;
            display: flex; align-items: center; justify-content: center; flex-shrink: 0;
        }

        .opt-info { flex: 1; min-width: 0; }

        .opt-code {
            font-family: monospace; font-size: .78rem; color: var(--cyan);
            background: rgba(6,182,212,.1); padding: 2px 7px;
            border-radius: 4px; margin-right: 6px;
        }

        .opt-loc { font-size: .85rem; color: var(--text); margin-top: 2px; }

        .fill-pill {
            font-size: .75rem; font-weight: 700;
            padding: 3px 9px; border-radius: 12px; flex-shrink: 0;
        }

        .fill-low  { background: rgba(34,197,94,.15);  color: var(--green); }
        .fill-mid  { background: rgba(245,158,11,.15); color: var(--amber); }
        .fill-high { background: rgba(239,68,68,.15);  color: var(--red); }

        .high-fill-badge {
            font-size: .7rem; font-weight: 700; padding: 2px 7px;
            border-radius: 10px; background: rgba(239,68,68,.2); color: var(--red);
            border: 1px solid rgba(239,68,68,.3);
        }

        /* ── Summary card ── */
        .summary-row {
            display: flex; justify-content: space-between; align-items: center;
            padding: 10px 0; border-bottom: 1px solid var(--border);
            font-size: .87rem;
        }

        .summary-row:last-child { border-bottom: none; }
        .summary-label { color: var(--muted); }
        .summary-value { color: var(--text); font-weight: 600; }

        .btn-apply {
            width: 100%; padding: 13px; border-radius: 10px; border: none;
            background: var(--cyan); color: var(--s2);
            font-size: .95rem; font-weight: 700; cursor: pointer;
            transition: opacity .15s; margin-top: 18px;
        }

        .btn-apply:hover { opacity: .85; }

        .btn-cancel {
            display: block; width: 100%; padding: 11px; border-radius: 10px;
            border: 1px solid var(--border); background: transparent;
            color: var(--muted); font-size: .87rem; font-weight: 600;
            text-align: center; text-decoration: none;
            transition: all .15s; margin-top: 8px;
        }

        .btn-cancel:hover { color: var(--text); border-color: var(--text); }

        .connector-line {
            width: 2px; height: 10px; background: var(--s3);
            margin: 0 0 0 33px;
        }

        .arrow-indicator {
            display: flex; align-items: center; gap: 6px;
            font-size: .78rem; color: var(--muted); margin: 4px 0 4px 44px;
        }
    </style>
}

<div class="page-container">
    <div style="margin-bottom:16px;">
        <a asp-action="Details" asp-route-id="@route?.Id"
           style="color:var(--muted);text-decoration:none;font-size:.85rem;">
            <i class="fa-solid fa-chevron-left"></i> Voltar à Rota
        </a>
    </div>

    <div class="optimise-header">
        <div>
            <h1 style="font-size:1.5rem;font-weight:800;color:var(--text);margin:0 0 4px 0;">
                <i class="fa-solid fa-wand-magic-sparkles" style="color:var(--cyan);margin-right:8px;"></i>
                Optimização de Rota
            </h1>
            <p style="color:var(--muted);margin:0;font-size:.88rem;">
                @route?.Code – @route?.Name
            </p>
        </div>
    </div>

    <div class="info-banner">
        <i class="fa-solid fa-circle-info"></i>
        <p>
            @Model.Message
            O algoritmo <strong>Nearest-Neighbour</strong> prioriza contentores com enchimento ≥ 80%
            e minimiza a distância total de percurso. Confirme a ordem antes de aplicar.
        </p>
    </div>

    <div class="optimise-grid">
        <!-- Stops list -->
        <div class="panel">
            <div class="panel-title">
                <i class="fa-solid fa-list-ol"></i>
                Ordem Optimizada (@Model.Stops.Count paragens)
            </div>

            @for (int i = 0; i < Model.Stops.Count; i++)
            {
                var s = Model.Stops[i];
                var fillClass = s.FillLevel >= 80 ? "fill-high" : s.FillLevel >= 50 ? "fill-mid" : "fill-low";
                <div class="opt-stop">
                    <div class="opt-num">@s.PickupOrder</div>
                    <div class="opt-info">
                        <div>
                            <span class="opt-code">@s.Code</span>
                            @if (s.FillLevel >= 80)
                            {
                                <span class="high-fill-badge">
                                    <i class="fa-solid fa-fire"></i> Crítico
                                </span>
                            }
                        </div>
                        <div class="opt-loc">@s.Location</div>
                        @if (s.Latitude == 0 && s.Longitude == 0)
                        {
                            <div style="font-size:.75rem;color:var(--amber);margin-top:2px;">
                                <i class="fa-solid fa-triangle-exclamation"></i> Sem coordenadas GPS
                            </div>
                        }
                    </div>
                    <span class="fill-pill @fillClass">@s.FillLevel%</span>
                </div>

                @if (i < Model.Stops.Count - 1)
                {
                    <div class="arrow-indicator">
                        <i class="fa-solid fa-arrow-down"></i>
                        <span>próxima paragem</span>
                    </div>
                }
            }
        </div>

        <!-- Sidebar summary + apply -->
        <div>
            <div class="panel">
                <div class="panel-title" style="margin-bottom:14px;">
                    <i class="fa-solid fa-chart-simple"></i> Resumo
                </div>

                <div class="summary-row">
                    <span class="summary-label">Paragens</span>
                    <span class="summary-value">@Model.Stops.Count</span>
                </div>
                <div class="summary-row">
                    <span class="summary-label">Distância est.</span>
                    <span class="summary-value">@Model.EstimatedDistanceKm km</span>
                </div>
                <div class="summary-row">
                    <span class="summary-label">Críticos (≥80%)</span>
                    <span class="summary-value" style="color:var(--red);">
                        @Model.Stops.Count(s => s.FillLevel >= 80)
                    </span>
                </div>
                <div class="summary-row">
                    <span class="summary-label">Sem GPS</span>
                    <span class="summary-value" style="color:var(--amber);">
                        @Model.Stops.Count(s => s.Latitude == 0 && s.Longitude == 0)
                    </span>
                </div>

                <!-- Apply form -->
                <form asp-action="ApplyOptimisation" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="routeId" value="@route?.Id" />
                    @foreach (var s in Model.Stops)
                    {
                        <input type="hidden" name="orderedContainerIds" value="@s.ContainerId" />
                    }
                    <button type="submit" class="btn-apply"
                            onclick="return confirm('Aplicar esta ordem optimizada à rota?')">
                        <i class="fa-solid fa-check" style="margin-right:6px;"></i>
                        Aplicar Optimização
                    </button>
                </form>

                <a asp-action="Details" asp-route-id="@route?.Id" class="btn-cancel">
                    Cancelar
                </a>
            </div>
        </div>
    </div>
</div>
