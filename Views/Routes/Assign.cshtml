@model EcoCityWaste.Models.ViewModels.RouteAssignViewModel
@using EcoCityWaste.Models
@{
    ViewData["Title"] = "Atribuir Rota";
    var route     = ViewBag.Route     as Route;
    var employees = ViewBag.Employees as List<User> ?? new List<User>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <style>
        :root {
            --purple: #8b5cf6; --s2: #1e293b; --s3: #334155;
            --border: rgba(255,255,255,.07); --text: #f1f5f9; --muted: #94a3b8;
            --red: #ef4444;
        }

        .assign-wrapper {
            max-width: 560px;
            margin: 0 auto;
        }

        .panel {
            background: var(--s2);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 28px;
        }

        .panel-title {
            font-size: 1.1rem; font-weight: 700; color: var(--text);
            margin-bottom: 20px; display: flex; align-items: center; gap: 10px;
        }

        .panel-title i { color: var(--purple); }

        .route-card {
            background: var(--s3);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 14px 16px;
            margin-bottom: 24px;
        }

        .route-card-code {
            font-family: monospace; font-size: .78rem; color: var(--purple);
            background: rgba(139,92,246,.1); padding: 2px 8px;
            border-radius: 4px; margin-bottom: 4px; display: inline-block;
        }

        .route-card-name {
            font-size: 1rem; font-weight: 700; color: var(--text);
        }

        /* Employee picker */
        .emp-list {
            display: flex; flex-direction: column; gap: 8px;
            margin-bottom: 20px;
        }

        .emp-item {
            display: flex; align-items: center; gap: 12px;
            padding: 12px 16px;
            background: var(--s3);
            border: 2px solid var(--border);
            border-radius: 10px;
            cursor: pointer;
            transition: border-color .15s, background .15s;
        }

        .emp-item:hover { border-color: var(--purple); background: rgba(139,92,246,.07); }

        .emp-item input[type="radio"] { display: none; }

        .emp-item.checked { border-color: var(--purple); background: rgba(139,92,246,.12); }

        .emp-avatar {
            width: 36px; height: 36px; border-radius: 50%;
            background: linear-gradient(135deg, var(--purple), #6d28d9);
            color: #fff; font-size: .85rem; font-weight: 700;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0; text-transform: uppercase;
        }

        .emp-info { flex: 1; }
        .emp-name { font-size: .9rem; font-weight: 600; color: var(--text); }
        .emp-email { font-size: .78rem; color: var(--muted); }

        .emp-check {
            width: 20px; height: 20px; border-radius: 50%;
            border: 2px solid var(--border);
            display: flex; align-items: center; justify-content: center;
            font-size: .65rem; color: #fff;
        }

        .emp-item.checked .emp-check {
            background: var(--purple); border-color: var(--purple);
        }

        .no-employees {
            text-align: center; padding: 30px;
            color: var(--muted); font-size: .88rem;
        }

        .field-error { font-size: .78rem; color: var(--red); margin-bottom: 10px; display: block; }

        .btn-assign {
            width: 100%; padding: 13px; border-radius: 10px; border: none;
            background: var(--purple); color: #fff;
            font-size: .95rem; font-weight: 700; cursor: pointer;
            transition: opacity .15s;
        }

        .btn-assign:hover { opacity: .85; }

        .btn-cancel {
            display: block; width: 100%; padding: 11px;
            border-radius: 10px; border: 1px solid var(--border);
            background: transparent; color: var(--muted);
            font-size: .87rem; font-weight: 600;
            text-align: center; text-decoration: none;
            transition: all .15s; margin-top: 8px;
        }

        .btn-cancel:hover { color: var(--text); border-color: var(--text); }
    </style>
}

<div class="page-container">
    <div style="margin-bottom:16px;">
        <a asp-action="Details" asp-route-id="@route?.Id"
           style="color:var(--muted);text-decoration:none;font-size:.85rem;">
            <i class="fa-solid fa-chevron-left"></i> Voltar à Rota
        </a>
    </div>

    <div class="assign-wrapper">
        <div class="panel">
            <div class="panel-title">
                <i class="fa-solid fa-user-plus"></i>
                Atribuir Rota a Funcionário
            </div>

            <!-- Route info -->
            <div class="route-card">
                <span class="route-card-code">@route?.Code</span>
                <div class="route-card-name">@route?.Name</div>
            </div>

            <form asp-action="Assign" method="post" id="assignForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="RouteId" />

                <label style="font-size:.8rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:12px;display:block;">
                    Selecione um Funcionário *
                </label>

                <span asp-validation-for="EmployeeId" class="field-error"></span>

                @if (!employees.Any())
                {
                    <div class="no-employees">
                        <i class="fa-solid fa-users" style="font-size:2rem;opacity:.3;display:block;margin-bottom:10px;"></i>
                        Nenhum funcionário disponível no sistema.
                    </div>
                }
                else
                {
                    <div class="emp-list" id="empList">
                        @foreach (var emp in employees)
                        {
                            <label class="emp-item" onclick="selectEmp(this, @emp.Id)">
                                <input type="radio" name="EmployeeId" value="@emp.Id" />
                                <div class="emp-avatar">@emp.Username.Substring(0, 1)</div>
                                <div class="emp-info">
                                    <div class="emp-name">@emp.Username</div>
                                    <div class="emp-email">@emp.Email</div>
                                </div>
                                <div class="emp-check">
                                    <i class="fa-solid fa-check"></i>
                                </div>
                            </label>
                        }
                    </div>
                }

                <button type="submit" class="btn-assign" @(employees.Any() ? "" : "disabled")>
                    <i class="fa-solid fa-check" style="margin-right:6px;"></i>
                    Atribuir Rota
                </button>
            </form>

            <a asp-action="Details" asp-route-id="@route?.Id" class="btn-cancel">Cancelar</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function selectEmp(label, id) {
            document.querySelectorAll('.emp-item').forEach(el => el.classList.remove('checked'));
            label.classList.add('checked');
            label.querySelector('input[type="radio"]').checked = true;
        }
    </script>
}
