@model EcoCityWaste.Models.ViewModels.RouteAssignViewModel
@using EcoCityWaste.Models
@{
    ViewData["Title"] = "Atribuir Rota";
    var route = ViewBag.Route as Route;
    var employees = ViewBag.Employees as List<User> ?? new List<User>();
}

<style>

    :root {
        --cor-castanho: rgb(141,110,99);
        --cor-bege: rgb(224,205,169);
        --cor-fundo-claro: rgb(243,242,235);
        --cor-sucesso: #27ae60;
        --cor-aviso: #f1c40f;
        --cor-vermelho-erro: #a94442;
        --cor-manutencao: #3498db;
        --border: #e6e6e6;
        --text: #444;
        --muted: #777;
        --surface: #ffffff;
        --surface-3: #f7f6f2;
    }

    .assign-wrapper {
        max-width: 560px;
        margin: 0 auto;
    }

    .panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 15px;
        padding: 26px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    }

    .panel-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--cor-castanho);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .route-card {
        background: var(--surface-3);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 14px 16px;
        margin-bottom: 24px;
    }

    .route-card-code {
        font-family: monospace;
        font-size: .78rem;
        color: var(--cor-castanho);
        background: #f3ebe8;
        padding: 2px 8px;
        border-radius: 4px;
        margin-bottom: 4px;
        display: inline-block;
    }

    .route-card-name {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text);
    }

    .emp-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 20px;
    }

    .emp-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        background: var(--surface-3);
        border: 2px solid var(--border);
        border-radius: 10px;
        cursor: pointer;
        /* transition:border-color .15s, background .15s; */
        transition: all .18s ease;
    }

        .emp-item:hover {
            border-color: var(--cor-castanho);
        }

        .emp-item input[type="radio"] {
            display: none;
        }

        .emp-item.checked {
            border-color: var(--cor-castanho);
            background: #f3ebe8;
            transform: scale(1.02);
            box-shadow: 0 4px 10px rgba(0,0,0,0.06);
        }

    .emp-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--cor-castanho);
        color: white;
        font-size: .85rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        text-transform: uppercase;
    }

    .emp-info {
        flex: 1;
    }

    .emp-name {
        font-size: .9rem;
        font-weight: 600;
        color: var(--text);
    }

    .emp-email {
        font-size: .78rem;
        color: var(--muted);
    }

    .emp-check {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 2px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .65rem;
        color: white;
    }

    .emp-item.checked .emp-check {
        background: var(--cor-castanho);
        border-color: var(--cor-castanho);
    }

    .no-employees {
        text-align: center;
        padding: 30px;
        color: var(--muted);
        font-size: .88rem;
    }

    .field-error {
        font-size: .78rem;
        color: var(--cor-vermelho-erro);
        margin-bottom: 10px;
        display: block;
    }

    .btn-assign {
        width: 100%;
        padding: 13px;
        border-radius: 10px;
        border: none;
        background: var(--cor-castanho);
        color: white;
        font-size: .95rem;
        font-weight: 700;
        cursor: pointer;
    }

        .btn-assign:hover {
            opacity: .9;
        }

    .btn-cancel {
        display: block;
        width: 100%;
        padding: 11px;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: white;
        color: var(--muted);
        font-size: .87rem;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        margin-top: 8px;
    }

        .btn-cancel:hover {
            color: var(--text);
            border-color: var(--cor-castanho);
        }

</style>

<div class="page-container">
    <div class="assign-wrapper">
        <div class="panel">
            <div class="panel-title" style="justify-content: space-between; margin-bottom: 25px; border-bottom: 1px solid var(--border); padding-bottom: 15px;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <i class="fa-solid fa-user-plus"></i>
                    <span>Atribuir Rota a Funcionário</span>
                    <span data-bs-toggle="tooltip" title="O funcionário selecionado receberá imediatamente esta rota na sua lista de tarefas diárias." style="cursor: help; color: #bcaaa4; margin-left: 5px; font-size: 1.1rem;">
                        <i class="fa-solid fa-circle-info"></i>
                    </span>
                </div>
                <a asp-action="Details" asp-route-id="@route?.Id"
                       style="text-decoration:none; color: white; background: var(--cor-castanho); border-radius: 8px; gap: 6px; padding: 6px 12px; font-size: .8rem; display: flex; align-items: center; font-weight: 600; transition: all 0.2s;">
                    <i class="fa-solid fa-chevron-left"></i> Voltar
                </a>
            </div>

            <div class="route-card">
                <span class="route-card-code">@route?.Code</span>
                <div class="route-card-name">@route?.Name</div>

                <div style="margin-top:8px;font-size:.85rem;color:var(--muted);">
                    Estado atual:
                    <strong style="color:var(--cor-castanho)">@route?.Status</strong>
                </div>

                <div style="font-size:.8rem;color:var(--muted);margin-top:4px;">
                    <i class="fa-regular fa-calendar me-1"></i> Criada em: @route?.CreatedAt.ToString("dd/MM/yyyy 'às' HH:mm")
                </div>
            </div>

            <form asp-action="Assign" method="post" id="assignForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="RouteId" />

                <label style="font-size:.85rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--cor-castanho); margin-bottom:12px; display:block;">
                    Selecione o Funcionário
                </label>

                <div style="position: relative; margin-bottom: 15px;">
                    <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #888;"></i>
                    <input type="text" id="empSearch" placeholder="Pesquisar funcionário por nome ou e-mail..."
                           style="width:100%; padding:12px 15px 12px 40px; border-radius:10px; border:1px solid var(--border); font-size:.9rem; outline:none; transition: border-color 0.3s;">
                </div>

                <span asp-validation-for="EmployeeId" class="field-error"></span>

                @if (!employees.Any())
                {
                    <div class="no-employees">
                        <i class="fa-solid fa-users" style="font-size:2.5rem; color: #d6c3a3; display:block; margin-bottom:10px;"></i>
                        Nenhum motorista ou funcionário disponível no sistema.
                    </div>
                }
                else
                {
                    <div class="emp-list" id="empList">
                        @foreach (var emp in employees)
                        {
                            <label class="emp-item" onclick="selectEmp(this, @emp.Id)">
                                <input type="radio" name="EmployeeId" value="@emp.Id" @(Model.EmployeeId == emp.Id ? "checked" : "") />
                                <div class="emp-avatar">@emp.Username.Substring(0, 1)</div>
                                <div class="emp-info">
                                    <div class="emp-name">@emp.Username</div>
                                    <div class="emp-email">@emp.Email</div>
                                </div>
                                <div class="emp-check">
                                    <i class="fa-solid fa-check"></i>
                                </div>
                            </label>
                        }
                    </div>
                }

                <button type="submit" class="btn-assign" @(employees.Any() ? "" : "disabled") style="display: flex; justify-content: center; align-items: center; border-radius: 10px;">
                    <i class="fa-solid fa-paper-plane" style="margin-right:8px;"></i> Confirmar Atribuição
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function selectEmp(label, id) {
            document.querySelectorAll('.emp-item').forEach(el => el.classList.remove('checked'));
            label.classList.add('checked');
            label.querySelector('input[type="radio"]').checked = true;
        }

        function selectEmp(label, id) {
            document.querySelectorAll('.emp-item').forEach(el => el.classList.remove('checked'));
            label.classList.add('checked');
            label.querySelector('input[type="radio"]').checked = true;
        }

        document.getElementById('empSearch')?.addEventListener('input', function () {
            const term = this.value.toLowerCase();

            document.querySelectorAll('.emp-item').forEach(item => {
                const name = item.querySelector('.emp-name').innerText.toLowerCase();
                const email = item.querySelector('.emp-email').innerText.toLowerCase();

                item.style.display =
                    name.includes(term) || email.includes(term)
                        ? 'flex'
                        : 'none';
            });
        });

        document.addEventListener('DOMContentLoaded', function () {
            const selected = document.querySelector('input[name="EmployeeId"]:checked');
            if (selected) {
                const label = selected.closest('.emp-item');
                if (label) {
                    label.classList.add('checked');
                }
            }
        });
    </script>
}
