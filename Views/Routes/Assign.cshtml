@model EcoCityWaste.Models.ViewModels.RouteAssignViewModel
@using EcoCityWaste.Models
@{
    ViewData["Title"] = "Atribuir Rota";
    var route     = ViewBag.Route     as Route;
    var employees = ViewBag.Employees as List<User> ?? new List<User>();
}

<style>

:root{
    --cor-castanho: rgb(141,110,99);
    --cor-bege: rgb(224,205,169);
    --cor-fundo-claro: rgb(243,242,235);

    --cor-sucesso:#27ae60;
    --cor-aviso:#f1c40f;
    --cor-vermelho-erro:#a94442;
    --cor-manutencao:#3498db;

    --border:#e6e6e6;
    --text:#444;
    --muted:#777;

    --surface:#ffffff;
    --surface-3:#f7f6f2;
}

.assign-wrapper{
    max-width:560px;
    margin:0 auto;
}

.panel{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:15px;
    padding:26px;
    box-shadow:0 4px 15px rgba(0,0,0,0.03);
}

.panel-title{
    font-size:1.1rem;
    font-weight:700;
    color:var(--cor-castanho);
    margin-bottom:20px;
    display:flex;
    align-items:center;
    gap:10px;
}

.panel-title i{
    color:var(--cor-castanho);
}

.route-card{
    background:var(--surface-3);
    border:1px solid var(--border);
    border-radius:10px;
    padding:14px 16px;
    margin-bottom:24px;
}

.route-card-code{
    font-family:monospace;
    font-size:.78rem;
    color:var(--cor-castanho);
    background:#f3ebe8;
    padding:2px 8px;
    border-radius:4px;
    margin-bottom:4px;
    display:inline-block;
}

.route-card-name{
    font-size:1rem;
    font-weight:700;
    color:var(--text);
}

.emp-list{
    display:flex;
    flex-direction:column;
    gap:8px;
    margin-bottom:20px;
}

.emp-item{
    display:flex;
    align-items:center;
    gap:12px;
    padding:12px 16px;
    background:var(--surface-3);
    border:2px solid var(--border);
    border-radius:10px;
    cursor:pointer;
    transition:border-color .15s, background .15s;
}

.emp-item:hover{
    border-color:var(--cor-castanho);
}

.emp-item input[type="radio"]{
    display:none;
}

.emp-item.checked{
    border-color:var(--cor-castanho);
    background:#f3ebe8;
}

.emp-avatar{
    width:36px;
    height:36px;
    border-radius:50%;
    background:var(--cor-castanho);
    color:white;
    font-size:.85rem;
    font-weight:700;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-shrink:0;
    text-transform:uppercase;
}

.emp-info{
    flex:1;
}

.emp-name{
    font-size:.9rem;
    font-weight:600;
    color:var(--text);
}

.emp-email{
    font-size:.78rem;
    color:var(--muted);
}

.emp-check{
    width:20px;
    height:20px;
    border-radius:50%;
    border:2px solid var(--border);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:.65rem;
    color:white;
}

.emp-item.checked .emp-check{
    background:var(--cor-castanho);
    border-color:var(--cor-castanho);
}

.no-employees{
    text-align:center;
    padding:30px;
    color:var(--muted);
    font-size:.88rem;
}

.field-error{
    font-size:.78rem;
    color:var(--cor-vermelho-erro);
    margin-bottom:10px;
    display:block;
}

.btn-assign{
    width:100%;
    padding:13px;
    border-radius:10px;
    border:none;
    background:var(--cor-castanho);
    color:white;
    font-size:.95rem;
    font-weight:700;
    cursor:pointer;
}

.btn-assign:hover{
    opacity:.9;
}

.btn-cancel{
    display:block;
    width:100%;
    padding:11px;
    border-radius:10px;
    border:1px solid var(--border);
    background:white;
    color:var(--muted);
    font-size:.87rem;
    font-weight:600;
    text-align:center;
    text-decoration:none;
    margin-top:8px;
}

.btn-cancel:hover{
    color:var(--text);
    border-color:var(--cor-castanho);
}

</style>

<div class="page-container">
    <div style="margin-bottom:16px;">
        <a asp-action="Details" asp-route-id="@route?.Id"
           style="color:var(--muted);text-decoration:none;font-size:.85rem;">
            <i class="fa-solid fa-chevron-left"></i> Voltar à Rota
        </a>
    </div>

    <div class="assign-wrapper">
        <div class="panel">
            <div class="panel-title">
                <i class="fa-solid fa-user-plus"></i>
                Atribuir Rota a Funcionário
            </div>

            <!-- informacoes da rota -->
            <div class="route-card">
                <span class="route-card-code">@route?.Code</span>
                <div class="route-card-name">@route?.Name</div>
            </div>

            <form asp-action="Assign" method="post" id="assignForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="RouteId" />

                <label style="font-size:.8rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:12px;display:block;">
                    Selecione um Funcionário *
                </label>

                <span asp-validation-for="EmployeeId" class="field-error"></span>

                @if (!employees.Any())
                {
                    <div class="no-employees">
                        <i class="fa-solid fa-users" style="font-size:2rem;opacity:.3;display:block;margin-bottom:10px;"></i>
                        Nenhum funcionário disponível no sistema.
                    </div>
                }
                else
                {
                    <div class="emp-list" id="empList">
                        @foreach (var emp in employees)
                        {
                            <label class="emp-item" onclick="selectEmp(this, @emp.Id)">
                                <input type="radio" name="EmployeeId" value="@emp.Id" />
                                <div class="emp-avatar">@emp.Username.Substring(0, 1)</div>
                                <div class="emp-info">
                                    <div class="emp-name">@emp.Username</div>
                                    <div class="emp-email">@emp.Email</div>
                                </div>
                                <div class="emp-check">
                                    <i class="fa-solid fa-check"></i>
                                </div>
                            </label>
                        }
                    </div>
                }

                <button type="submit" class="btn-assign" @(employees.Any() ? "" : "disabled")>
                    <i class="fa-solid fa-check" style="margin-right:6px;"></i>
                    Atribuir Rota
                </button>
            </form>

            <a asp-action="Details" asp-route-id="@route?.Id" class="btn-cancel">Cancelar</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function selectEmp(label, id) {
            document.querySelectorAll('.emp-item').forEach(el => el.classList.remove('checked'));
            label.classList.add('checked');
            label.querySelector('input[type="radio"]').checked = true;
        }
    </script>
}
