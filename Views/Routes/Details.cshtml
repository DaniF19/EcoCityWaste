@model EcoCityWaste.Models.Route

@{
    ViewData["Title"] = $"Rota {Model.Code}";
    bool isAdmin = User.IsInRole("Admin");

    var orderedStops = Model.RouteContainers
        .OrderBy(rc => rc.PickupOrder)
        .ToList();
}

@section Styles {
    <style>

        :root {
            --br: #8D6E63;
            --br-dk: #6D4C41;
            --br-lt: #A1887F;
            --tint: #f3ebe8;
            --tint2: #ede0da;
            --bg: #F5F3EE;
            --sf: #FFFFFF;
            --sf2: #FAF9F6;
            --bd: #E8E3DC;
            --bd2: #D5CEC6;
            --tx: #2C2420;
            --tx2: #6B5E58;
            --mu: #9E8E88;
            --ok: #27AE60;
            --ok-bg: #E8F5E9;
            --ok-bd: #A5D6A7;
            --wa: #F39C12;
            --wa-bg: #FFF8E1;
            --wa-bd: #FFE082;
            --er: #C0392B;
            --er-bg: #FDEDEC;
            --er-bd: #F5B7B1;
            --inf: #2980B9;
            --inf-bg: #EBF5FB;
            --inf-bd: #AED6F1;
            --shd: 0 1px 4px rgba(0,0,0,.06);
            --rad: 12px;
            --rads: 8px;
            --tr: all .18s ease;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            color: var(--tx);
        }

        .d-wrap {
            max-width: 900px;
            margin: 0 auto;
            padding-bottom: 40px;
        }

        .d-grid {
            display: grid;
            grid-template-columns: 1fr 280px;
            gap: 16px;
        }
        @@media (max-width: 780px) {
            .d-grid {
                grid-template-columns: 1fr;
            }
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: .8rem;
            color: white;
            padding: 6px 13px 6px 9px;
            border-radius: var(--rads);
            border: 1px solid var(--bd);
            background: rgb(141,110,99);
            text-decoration: none;
            margin-bottom: 16px;
            transition: var(--tr);
            box-shadow: var(--shd);
        }

            .back-link:hover {
                text-decoration:none;
            }

        .toast {
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--ok);
            color: #fff;
            border-radius: var(--rads);
            padding: 10px 14px;
            font-size: .85rem;
            font-weight: 600;
            margin-bottom: 16px;
            animation: fadeUp .3s ease;
        }

        .d-header {
            background: var(--sf);
            border: 1px solid var(--bd);
            border-radius: var(--rad);
            padding: 18px 20px;
            margin-bottom: 16px;
            box-shadow: var(--shd);
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .d-header-left {
            flex: 1;
            min-width: 0;
        }

        .d-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--tx);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .d-sub {
            font-size: .82rem;
            color: var(--mu);
            margin-top: 3px;
        }

        .code-chip {
            font-family: 'DM Mono', monospace;
            font-size: .72rem;
            font-weight: 500;
            color: var(--br);
            background: var(--tint);
            border: 1px solid var(--tint2);
            padding: 2px 8px;
            border-radius: 5px;
            margin-right: 8px;
        }

        .status-pill {
            font-size: .68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .05em;
            padding: 3px 9px;
            border-radius: 20px;
            flex-shrink: 0;
        }

        .sp-pending {
            background: var(--wa-bg);
            color: var(--wa);
            border: 1px solid var(--wa-bd);
        }

        .sp-inprogress {
            background: var(--inf-bg);
            color: var(--inf);
            border: 1px solid var(--inf-bd);
        }

        .sp-completed {
            background: var(--ok-bg);
            color: var(--ok);
            border: 1px solid var(--ok-bd);
        }

        .sp-cancelled {
            background: var(--er-bg);
            color: var(--er);
            border: 1px solid var(--er-bd);
        }

        .panel {
            background: var(--sf);
            border: 1px solid var(--bd);
            border-radius: var(--rad);
            overflow: hidden;
            box-shadow: var(--shd);
            margin-bottom: 14px;
        }

        .panel-hd {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 16px;
            border-bottom: 1px solid var(--bd);
            background: var(--sf2);
            font-size: .8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--mu);
        }

            .panel-hd i {
                color: var(--br);
                font-size: .8rem;
            }

        .stop {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 11px 16px;
            border-bottom: 1px solid var(--bd);
            transition: var(--tr);
        }

            .stop:last-child {
                border-bottom: none;
            }

            .stop:hover {
                background: var(--sf2);
            }

        .stop-num {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--br);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .72rem;
            font-weight: 700;
            flex-shrink: 0;
        }

        .stop-body {
            flex: 1;
            min-width: 0;
        }

        .stop-top {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 3px;
        }

        .stop-code {
            font-family: 'DM Mono', monospace;
            font-size: .7rem;
            font-weight: 500;
            color: var(--br);
            background: var(--tint);
            border: 1px solid var(--tint2);
            padding: 1px 6px;
            border-radius: 4px;
        }

        .stop-type {
            font-size: .74rem;
            color: var(--mu);
        }

        .stop-loc {
            font-size: .82rem;
            color: var(--tx2);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .bar-wrap {
            height: 4px;
            background: var(--bd);
            border-radius: 3px;
            margin-top: 5px;
        }

        .bar-fill {
            height: 100%;
            border-radius: 3px;
        }

        .fill-badge {
            font-size: .74rem;
            font-weight: 700;
            flex-shrink: 0;
            min-width: 38px;
            text-align: right;
        }

        .fl {
            color: var(--ok);
        }

        .fm {
            color: var(--wa);
        }

        .fh {
            color: var(--er);
        }

        .empty-stops {
            padding: 28px;
            text-align: center;
            font-size: .84rem;
            color: var(--mu);
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 16px;
            border-bottom: 1px solid var(--bd);
            gap: 12px;
        }

            .info-row:last-child {
                border-bottom: none;
            }

        .info-label {
            font-size: .8rem;
            color: var(--mu);
            flex-shrink: 0;
        }

        .info-value {
            font-size: .84rem;
            font-weight: 600;
            color: var(--tx);
            text-align: right;
        }

        .actions-grid {
            display: flex;
            flex-direction: column;
            gap: 6px;
            padding: 12px;
        }

        .act-btn {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 9px 13px;
            border-radius: var(--rads);
            font-family: 'DM Sans', sans-serif;
            font-size: .83rem;
            font-weight: 600;
            text-decoration: none;
            border: 1px solid var(--bd);
            background: var(--sf2);
            color: var(--tx2);
            cursor: pointer;
            transition: var(--tr);
            width: 100%;
        }

            .act-btn i {
                font-size: .8rem;
                color: var(--mu);
                width: 16px;
                text-align: center;
                flex-shrink: 0;
            }

            .act-btn:hover {
                background: var(--tint);
                border-color: var(--br-lt);
                color: var(--br-dk);
            }

                .act-btn:hover i {
                    color: var(--br);
                }

            .act-btn.primary {
                background: var(--br);
                color: #fff;
                border-color: var(--br-dk);
            }

                .act-btn.primary i {
                    color: rgba(255,255,255,.8);
                }

                .act-btn.primary:hover {
                    background: var(--br-dk);
                    border-color: var(--br-dk);
                    color: #fff;
                }

                .act-btn-delete {
                    display: flex;
                    align-items: center;
                    gap: 9px;
                    padding: 9px 13px;
                    border-radius: var(--rads);
                    font-family: 'DM Sans', sans-serif;
                    font-size: .83rem;
                    font-weight: 600;
                    text-decoration: none;
                    border: 1px solid var(--er-bd);
                    background: var(--er-bg);
                    color: var(--er);
                    cursor: pointer;
                    transition: var(--tr);
                    width: 100%;
                }

                .act-btn-delete i {
                    font-size: .8rem;
                    color: var(--er);
                    width: 16px;
                    text-align: center;
                    flex-shrink: 0;
                }

                .act-btn-delete:hover {
                    background: var(--er-bd);
                    border-color: var(--er);
                    color: var(--er);
                    box-shadow: 0 0 0 1px var(--er);
                }

                .act-btn-delete:hover i {
                    color: var(--er);
                }

        .act-divider {
            height: 1px;
            background: var(--bd);
            margin: 2px 0;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
}

<div class="page-container">
    <div class="d-wrap">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="toast">
                <i class="fa-solid fa-circle-check"></i>
                @TempData["SuccessMessage"]
            </div>
        }

      
        <a asp-action="Index" class="back-link">
            <i class="fa-solid fa-chevron-left"></i> Rotas
        </a>

  
        @{
            var (spClass, spIcon, spLabel) = Model.Status switch
            {
                EcoCityWaste.Models.Route.RouteStatus.Pending => ("sp-pending", "fa-clock", "Pendente"),
                EcoCityWaste.Models.Route.RouteStatus.InProgress => ("sp-inprogress", "fa-truck", "Em Curso"),
                EcoCityWaste.Models.Route.RouteStatus.Completed => ("sp-completed", "fa-circle-check", "Concluída"),
                EcoCityWaste.Models.Route.RouteStatus.Cancelled => ("sp-cancelled", "fa-ban", "Cancelada"),
                _ => ("sp-pending", "fa-clock", "Pendente")
            };
        }

        <div class="d-header">
            <div class="d-header-left">
                <div style="margin-bottom:5px;">
                    <span class="code-chip">@Model.Code</span>
                    <span class="status-pill @spClass">
                        <i class="fa-solid @spIcon" style="margin-right:3px;"></i>@spLabel
                    </span>
                </div>
                <div class="d-title">@Model.Name</div>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="d-sub">@Model.Description</div>
                }
            </div>
        </div>

   
        <div class="d-grid">

         
            <div>
                <div class="panel">
                    <div class="panel-hd">
                        <i class="fa-solid fa-list-ol"></i>
                        Paragens &nbsp;<span style="font-weight:400;color:var(--mu);">(@orderedStops.Count)</span>
                    </div>

                    @if (!orderedStops.Any())
                    {
                        <div class="empty-stops">
                            <i class="fa-solid fa-inbox" style="font-size:1.6rem;opacity:.25;display:block;margin-bottom:8px;"></i>
                            Nenhum contentor nesta rota.
                        </div>
                    }
                    else
                    {
                        @foreach (var stop in orderedStops)
                        {
                            var c = stop.Container;
                            var fc = c.FillLevel >= 80 ? "fh" : c.FillLevel >= 50 ? "fm" : "fl";
                            var barColor = c.FillLevel >= 80 ? "var(--er)" : c.FillLevel >= 50 ? "var(--wa)" : "var(--ok)";
                            var typeIcon = c.Type switch
                            {
                                        "Plástico" => "fa-bottle-water",
                                        "Vidro" => "fa-wine-glass-empty",
                                        "Papel" => "fa-box-archive",
                                        "Orgânico" => "fa-apple-whole",
                                        "Indiferenciado" => "fa-trash-can",
                                _ => "fa-trash-can"
                            };

                            <div class="stop">
                                <div class="stop-num">@stop.PickupOrder</div>
                                <div class="stop-body">
                                    <div class="stop-top">
                                        <span class="stop-code">@c.Code</span>
                                        <span class="stop-type">
                                            <i class="fa-solid @typeIcon"></i> @c.Type
                                        </span>
                                    </div>
                                    <div class="stop-loc">@c.Location</div>
                                    <div class="bar-wrap">
                                        <div class="bar-fill" style="width:@c.FillLevel%;background:@barColor;"></div>
                                    </div>
                                </div>
                                <span class="fill-badge @fc">@c.FillLevel%</span>
                            </div>
                        }
                    }
                </div>
            </div>

            <div>

                <div class="panel">
                    <div class="panel-hd">
                        <i class="fa-solid fa-circle-info"></i> Detalhes
                    </div>

                    <div class="info-row">
                        <span class="info-label">Criada por</span>
                        <span class="info-value">@Model.CreatedBy</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Criada em</span>
                        <span class="info-value">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Funcionário</span>
                        <span class="info-value">@(Model.AssignedEmployee?.Username ?? "—")</span>
                    </div>
                    @if (Model.AssignedAt.HasValue)
                    {
                        <div class="info-row">
                            <span class="info-label">Atribuída em</span>
                            <span class="info-value">@Model.AssignedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    }
                    @if (Model.CompletedAt.HasValue)
                    {
                        <div class="info-row">
                            <span class="info-label">Concluída em</span>
                            <span class="info-value">@Model.CompletedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    }
                </div>

                <div class="panel">
                    <div class="panel-hd">
                        <i class="fa-solid fa-bolt"></i> Ações
                    </div>
                    <div class="actions-grid">

                <a asp-action="Simulate" asp-route-id="@Model.Id" class="action-btn">
                    <i class="fa-solid fa-play"></i> Simular Rota
                </a>

                        @if (isAdmin && Model.Status != EcoCityWaste.Models.Route.RouteStatus.Completed)
                        {
                            <div class="act-divider"></div>

                            <a asp-action="Optimise" asp-route-id="@Model.Id" class="act-btn">
                                <i class="fa-solid fa-wand-magic-sparkles"></i> Optimizar Rota
                            </a>

                            <a asp-action="Map" asp-route-id="@Model.Id" class="act-btn">
                            <i class="fa-solid fa-map"></i> Ver no Mapa
                            </a>

                            <a asp-action="Assign" asp-route-id="@Model.Id" class="act-btn">
                                <i class="fa-solid fa-user-plus"></i> Atribuir Funcionário
                            </a>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="act-btn">
                                <i class="fa-solid fa-pen"></i> Editar Rota
                            </a>
                        }

                        @if (Model.Status == EcoCityWaste.Models.Route.RouteStatus.InProgress)
                        {
                            <div class="act-divider"></div>

                            <form asp-action="Complete" asp-route-id="@Model.Id" method="post" id="complete-form">
                                @Html.AntiForgeryToken()
                                <button type="button" class="act-btn primary" onclick="confirmComplete()" style="width:100%;">
                                    <i class="fa-solid fa-circle-check"></i>
                                    Marcar como Concluída
                                </button>
                            </form>
                        }

                        @if (isAdmin)
                        {
                            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" id="delete-form-detail">
                                @Html.AntiForgeryToken()
                                <button type="button" class="act-btn-delete" onclick="confirmDeleteDetail()" 
                                        style="width:100%; color:#a94442; border-color:#f5b7b1;">
                                    <i class="fa-solid fa-trash" style="color:#a94442;"></i> Eliminar Rota
                                </button>
                            </form>
                        }

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

<script>
    function confirmComplete() {
        Swal.fire({
            title: 'Concluir Rota?',
            text: 'Deseja marcar esta recolha como finalizada?',
            icon: 'question',
            iconColor: 'rgb(141,110,99)',
            showCancelButton: true,
            confirmButtonColor: 'rgb(141,110,99)',
            cancelButtonColor: '#777',
            confirmButtonText: 'Sim, concluir',
            cancelButtonText: 'Voltar'
        }).then(r => { if (r.isConfirmed) document.getElementById('complete-form').submit(); });
    }
    
    function confirmDeleteDetail() {
        Swal.fire({
            title: 'Eliminar Rota?',
            text: "Esta ação não pode ser revertida!",
            icon: 'warning',
            iconColor: '#d33',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#777',
            confirmButtonText: 'Sim, eliminar!',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('delete-form-detail').submit();
            }
        });
    }
</script>

