@model EcoCityWaste.Models.Route
@{
    ViewData["Title"] = $"Mapa – {Model.Code}";
    var stops = Model.RouteContainers.OrderBy(rc => rc.PickupOrder).ToList();
    bool isAdmin = User.IsInRole("Admin");
}

@section Styles {
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        :root {
            --blue: #3b82f6; --green: #22c55e; --amber: #f59e0b;
            --red: #ef4444; --s2: #1e293b; --s3: #334155;
            --border: rgba(255,255,255,.07); --text: #f1f5f9; --muted: #94a3b8;
        }

        .map-layout {
            display: grid;
            grid-template-columns: 1fr 320px;
            gap: 18px;
            height: calc(100vh - 160px);
        }

        @@media(max-width: 860px) {
            .map-layout { grid-template-columns: 1fr; height: auto; }
        }

        #map {
            width: 100%; height: 100%;
            min-height: 500px;
            border-radius: 14px;
            border: 1px solid var(--border);
            overflow: hidden;
        }

        .sidebar {
            display: flex; flex-direction: column; gap: 14px;
            overflow-y: auto;
            max-height: calc(100vh - 160px);
        }

        .sidebar::-webkit-scrollbar { width: 5px; }
        .sidebar::-webkit-scrollbar-thumb { background: var(--s3); border-radius: 4px; }

        .panel {
            background: var(--s2);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 18px;
            flex-shrink: 0;
        }

        .panel-title {
            font-size: .88rem; font-weight: 700; color: var(--text);
            margin-bottom: 14px; display: flex; align-items: center; gap: 7px;
        }

        .panel-title i { color: var(--blue); }

        /* Stop items */
        .map-stop {
            display: flex; align-items: center; gap: 10px;
            padding: 9px 12px; border-radius: 8px;
            background: var(--s3); border: 1px solid var(--border);
            margin-bottom: 6px; cursor: pointer;
            transition: border-color .12s, background .12s;
        }

        .map-stop:last-child { margin-bottom: 0; }
        .map-stop:hover { border-color: var(--blue); background: rgba(59,130,246,.07); }
        .map-stop.active { border-color: var(--blue); background: rgba(59,130,246,.12); }

        .map-stop.no-gps { opacity: .5; cursor: default; }
        .map-stop.no-gps:hover { border-color: var(--border); background: var(--s3); }

        .stop-num {
            width: 26px; height: 26px; border-radius: 50%;
            background: var(--blue); color: #fff;
            font-size: .72rem; font-weight: 700;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }

        .stop-info { flex: 1; min-width: 0; }
        .stop-code { font-family: monospace; font-size: .75rem; color: var(--blue); }
        .stop-loc  { font-size: .8rem; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        .fill-pill {
            font-size: .72rem; font-weight: 700; padding: 2px 8px;
            border-radius: 10px; flex-shrink: 0;
        }

        .fill-low  { background: rgba(34,197,94,.15);  color: var(--green); }
        .fill-mid  { background: rgba(245,158,11,.15); color: var(--amber); }
        .fill-high { background: rgba(239,68,68,.15);  color: var(--red); }

        .no-gps-warning {
            background: rgba(245,158,11,.1); border: 1px solid rgba(245,158,11,.2);
            border-radius: 9px; padding: 10px 14px;
            font-size: .8rem; color: var(--amber);
            display: flex; gap: 8px; align-items: flex-start;
        }

        .legend-item { display: flex; align-items: center; gap: 8px; margin-bottom: 7px; font-size: .82rem; color: var(--muted); }
        .legend-dot  { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; }

        .btn-back {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 8px 16px; border-radius: 8px;
            border: 1px solid var(--border); background: var(--s3);
            color: var(--muted); font-size: .83rem; text-decoration: none;
            transition: all .15s;
        }

        .btn-back:hover { color: var(--text); border-color: var(--text); }

        /* Leaflet popup custom */
        .leaflet-popup-content-wrapper {
            background: var(--s2) !important;
            border: 1px solid var(--border) !important;
            border-radius: 10px !important;
            box-shadow: 0 8px 24px rgba(0,0,0,.5) !important;
        }

        .leaflet-popup-content { color: var(--text) !important; font-size: .83rem !important; }
        .leaflet-popup-tip { background: var(--s2) !important; }
        .leaflet-popup-close-button { color: var(--muted) !important; }
    </style>
}

<div class="page-container" style="padding-bottom:0;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:10px;">
        <div style="display:flex;align-items:center;gap:12px;">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn-back">
                <i class="fa-solid fa-chevron-left"></i> Rota
            </a>
            <div>
                <span style="font-family:monospace;font-size:.8rem;color:var(--blue);">@Model.Code</span>
                <h1 style="font-size:1.2rem;font-weight:700;color:var(--text);margin:0;">
                    <i class="fa-solid fa-map" style="color:var(--green);margin-right:6px;"></i>
                    @Model.Name
                </h1>
            </div>
        </div>
    </div>

    <div class="map-layout">
        <!-- Map -->
        <div id="map"></div>

        <!-- Sidebar -->
        <div class="sidebar">
            @{
                var noGpsCount = stops.Count(s => s.Container.Latitude == 0 && s.Container.Longitude == 0);
            }

            @if (noGpsCount > 0)
            {
                <div class="no-gps-warning">
                    <i class="fa-solid fa-triangle-exclamation" style="flex-shrink:0;margin-top:1px;"></i>
                    <span>@noGpsCount contentor(es) sem coordenadas GPS não aparecem no mapa.</span>
                </div>
            }

            <div class="panel">
                <div class="panel-title">
                    <i class="fa-solid fa-list-ol"></i>
                    Paragens (@stops.Count)
                </div>

                @foreach (var stop in stops)
                {
                    var c = stop.Container;
                    var fillClass = c.FillLevel >= 80 ? "fill-high" : c.FillLevel >= 50 ? "fill-mid" : "fill-low";
                    var hasGps    = c.Latitude != 0 || c.Longitude != 0;

                    <div class="map-stop @(hasGps ? "" : "no-gps")"
                         id="sidebar-stop-@c.Id"
                         onclick="@(hasGps ? $"focusStop({c.Id})" : "")">
                        <div class="stop-num">@stop.PickupOrder</div>
                        <div class="stop-info">
                            <div class="stop-code">@c.Code</div>
                            <div class="stop-loc">@c.Location</div>
                            @if (!hasGps)
                            {
                                <div style="font-size:.72rem;color:var(--amber);">
                                    <i class="fa-solid fa-location-slash"></i> Sem GPS
                                </div>
                            }
                        </div>
                        <span class="fill-pill @fillClass">@c.FillLevel%</span>
                    </div>
                }
            </div>

            <div class="panel">
                <div class="panel-title"><i class="fa-solid fa-circle-info"></i> Legenda</div>
                <div class="legend-item">
                    <div class="legend-dot" style="background:#22c55e;"></div>
                    <span>Nível baixo (&lt; 50%)</span>
                </div>
                <div class="legend-item">
                    <div class="legend-dot" style="background:#f59e0b;"></div>
                    <span>Nível médio (50–79%)</span>
                </div>
                <div class="legend-item">
                    <div class="legend-dot" style="background:#ef4444;"></div>
                    <span>Nível crítico (≥ 80%)</span>
                </div>
                <div class="legend-item" style="margin-top:8px;">
                    <div style="width:28px;height:2px;background:#3b82f6;flex-shrink:0;border-radius:1px;"></div>
                    <span>Percurso da rota</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        // Build stops data from server
        const stopsData = [
            @foreach (var stop in stops)
            {
                var c = stop.Container;
                @Html.Raw($"{{ id:{c.Id}, order:{stop.PickupOrder}, code:'{c.Code}', loc:'{c.Location.Replace("'","\\'")}', fill:{c.FillLevel}, lat:{c.Latitude.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)}, lng:{c.Longitude.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)} }},")
            }
        ];

        const validStops = stopsData.filter(s => s.lat !== 0 || s.lng !== 0);

        // Initialise map
        const map = L.map('map', { zoomControl: true });

        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            attribution: '© OpenStreetMap, © CARTO',
            maxZoom: 19
        }).addTo(map);

        // Custom marker icon
        function makeIcon(order, fill) {
            const color = fill >= 80 ? '#ef4444' : fill >= 50 ? '#f59e0b' : '#22c55e';
            const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="36" height="44" viewBox="0 0 36 44">
                <path d="M18 0C8.06 0 0 8.06 0 18c0 13.5 18 26 18 26S36 31.5 36 18C36 8.06 27.94 0 18 0z"
                      fill="${color}" opacity="0.95"/>
                <text x="18" y="22" text-anchor="middle" dominant-baseline="middle"
                      font-size="13" font-weight="700" fill="white"
                      font-family="system-ui, sans-serif">${order}</text>
            </svg>`;
            return L.divIcon({
                className: '',
                html: svg,
                iconSize: [36, 44],
                iconAnchor: [18, 44],
                popupAnchor: [0, -46]
            });
        }

        const markers = {};

        validStops.forEach(s => {
            const marker = L.marker([s.lat, s.lng], { icon: makeIcon(s.order, s.fill) })
                .addTo(map)
                .bindPopup(`
                    <div style="min-width:160px;">
                        <div style="font-family:monospace;font-size:.78rem;color:#3b82f6;margin-bottom:4px;">${s.code}</div>
                        <div style="font-weight:700;font-size:.9rem;margin-bottom:6px;">${s.loc}</div>
                        <div style="display:flex;align-items:center;justify-content:space-between;">
                            <span style="font-size:.78rem;opacity:.7;">Paragem #${s.order}</span>
                            <span style="font-size:.8rem;font-weight:700;
                                color:${s.fill>=80?'#ef4444':s.fill>=50?'#f59e0b':'#22c55e'}">
                                ${s.fill}%
                            </span>
                        </div>
                        <div style="height:5px;background:#334155;border-radius:3px;margin-top:6px;overflow:hidden;">
                            <div style="height:100%;width:${s.fill}%;background:${s.fill>=80?'#ef4444':s.fill>=50?'#f59e0b':'#22c55e'};border-radius:3px;"></div>
                        </div>
                    </div>`);

            markers[s.id] = marker;
        });

        // Draw route polyline
        if (validStops.length > 1) {
            const latlngs = validStops.map(s => [s.lat, s.lng]);
            L.polyline(latlngs, { color: '#3b82f6', weight: 3, opacity: .75, dashArray: '6 4' }).addTo(map);
        }

        // Fit map to markers
        if (validStops.length > 0) {
            const bounds = L.latLngBounds(validStops.map(s => [s.lat, s.lng]));
            map.fitBounds(bounds, { padding: [40, 40] });
        } else {
            // Default to Portugal centre
            map.setView([38.7, -9.15], 7);
        }

        // Focus from sidebar
        function focusStop(id) {
            const marker = markers[id];
            if (!marker) return;
            map.flyTo(marker.getLatLng(), 16, { duration: 0.8 });
            marker.openPopup();
            document.querySelectorAll('.map-stop').forEach(el => el.classList.remove('active'));
            const el = document.getElementById('sidebar-stop-' + id);
            if (el) el.classList.add('active');
        }

        // Clicking a marker highlights sidebar item
        Object.entries(markers).forEach(([id, marker]) => {
            marker.on('click', () => {
                document.querySelectorAll('.map-stop').forEach(el => el.classList.remove('active'));
                const el = document.getElementById('sidebar-stop-' + id);
                if (el) { el.classList.add('active'); el.scrollIntoView({ behavior:'smooth', block:'nearest' }); }
            });
        });
    </script>
}
