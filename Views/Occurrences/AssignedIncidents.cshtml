@using EcoCityWaste.Helpers
@model List<EcoCityWaste.Models.Occurrence>

@{
    ViewData["Title"] = "Ocorrências atribuídas";
}

@section Styles {
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
}

<div class="page-container">

    <div class="card-box" style="max-width: 900px;">

        <div class="card-title"
             style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">

            <span style="margin: 0; font-size: 1.5rem; font-weight: bold; color: #8d6e63;">
                Ocorrências atribuídas
            </span>

            <a asp-controller="Funcionario" asp-action="Dashboard" class="btn-vista-analitica">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </a>

        </div>

        @if (!Model.Any())
        {
            <p style="text-align:center;">Sem ocorrências associadas a ti.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Contentor</th>
                        <th>Tipo</th>
                        <th>Descrição</th>
                        <th>Estado</th>
                        <th>Reportado em</th>
                        <th style="text-align:center;">Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var occ in Model.Where(o => o.Status != nameof(OccurrenceStatus.Pendente)))
                    {
                        <tr>
                            <td>@occ.ContainerCode</td>

                            <td>@occ.OccurrenceType</td>
                            <td>@occ.Description</td>

                            <td>
                                @(Enum.Parse<OccurrenceStatus>(occ.Status).ToDisplayName())
                            </td>

                            <td>@occ.ReportDate.ToString("dd/MM/yyyy HH:mm")</td>

                            <td style="text-align:center; display:flex; flex-direction:column; gap:6px; align-items:center;">
                                @if (occ.Status != nameof(OccurrenceStatus.Resolvido) &&
                                     occ.Status != nameof(OccurrenceStatus.Rejeitado))
                                {
                                    <a asp-controller="Occurrences"
                                       asp-action="UpdateStatus"
                                       asp-route-id="@occ.Id"
                                       class="btn-primary"
                                       style="padding:6px 12px; font-size:14px;">
                                        Atualizar estado
                                    </a>
                                }
                                else
                                {
                                    <span style="color:#777; font-size:0.9rem;">Sem ações</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

    </div>

</div>
