@model EcoCityWaste.ViewModels.AssignOccurrenceViewModel

@{
    ViewData["Title"] = "Atribuir Ocorrência";
}

@section Styles {
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
}

<div class="page-container">

    <div class="card-box" style="max-width: 700px;">

        <div class="card-title"
             style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">

            <span style="margin:0; font-size:1.5rem; font-weight:bold; color:#8d6e63;">
                Atribuir Ocorrência
            </span>

            <a asp-controller="Admin" asp-action="Dashboard" class="btn-vista-analitica">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </a>

        </div>


        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success" style="margin-bottom:20px;">
                <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" style="margin-bottom:20px;">
                <i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]
            </div>
        }

        <form asp-action="Assign" method="post">

            <div class="form-group" style="margin-bottom:20px;">
                <label style="font-weight:600; color:#795c4d;">Selecionar Ocorrência</label>
                <select asp-for="SelectedOccurrenceId" class="form-control"
                        style="border-radius:10px; padding:12px; border:1px solid #d6c3a3;">
                    <option disabled selected>Escolha uma ocorrência...</option>
                    @foreach (var o in Model.Occurrences)
                    {
                        <option value="@o.Id">
                            #@o.Id — @o.Description
                        </option>
                    }
                </select>
            </div>

            <div class="form-group" style="margin-bottom:20px;">
                <label style="font-weight:600; color:#795c4d;">Atribuir a Funcionário</label>
                <select asp-for="SelectedEmployeeId" class="form-control"
                        style="border-radius:10px; padding:12px; border:1px solid #d6c3a3;">
                    <option disabled selected>Escolha um funcionário...</option>

                    @foreach (var e in Model.Employees)
                    {
                        var count = Model.EmployeeOccurrenceCounts.ContainsKey(e.Id)
                        ? Model.EmployeeOccurrenceCounts[e.Id]
                        : 0;

                        <option value="@e.Id">
                            @e.Username (@count atribuídas)
                        </option>
                    }
                </select>

            </div>

            <button type="submit"
                    class="btn-primary"
                    style="padding:10px 24px; font-size:1rem; border-radius:50px; display:inline-flex; align-items:center; gap:8px;">
                <i class="fa-solid fa-user-check"></i> Atribuir
            </button>

        </form>

    </div>

</div>

<style>
    .btn-primary {
        background-color: #8d6e63;
        color: white !important;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background-color: #795c4d;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(141, 110, 99, 0.2);
        }

    .alert-success {
        background-color: #e4f5e9;
        color: #2e7d32;
        border-left: 4px solid #2e7d32;
        padding: 12px 16px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
</style>
