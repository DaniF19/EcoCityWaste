@model EcoCityWaste.ViewModels.AssignOccurrenceViewModel

@{
    ViewData["Title"] = "Atribuir Ocorrência";
}

@section Styles {
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
}

<div class="page-container">
    <div class="card-box" style="max-width: 600px; margin: 0 auto; padding: 40px;">

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
            <h2 style="color: #8d6e63; font-weight: bold; margin: 0; font-size: 1.6rem;">Atribuir Tarefa</h2>

            <a asp-controller="Admin" asp-action="Dashboard" class="btn-vista-analitica">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div style="background-color: #d4edda; color: #155724; padding: 15px; border-radius: 10px; margin-bottom: 20px; font-weight: 600;">
                <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div style="background-color: #f8d7da; color: #721c24; padding: 15px; border-radius: 10px; margin-bottom: 20px; font-weight: 600;">
                <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["Error"]
            </div>
        }

        <form asp-action="Assign" method="post">

            <div style="margin-bottom: 25px;">
                <label style="font-weight: 700; color: #795c4d; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px; display: block;">
                    1. Ocorrência Pendente
                </label>

                <div style="position: relative;">
                    <i class="fa-solid fa-clipboard-list" style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #8d6e63;"></i>
                    <select asp-for="SelectedOccurrenceId" class="form-select custom-select" style="padding-left: 45px; border-radius: 10px; border: 1px solid #ddd; height: 50px; background-color: #f9f9f9;">
                        <option value="">Selecione a anomalia a resolver...</option>
                        @if (Model.Occurrences != null)
                        {
                            foreach (var occ in Model.Occurrences)
                            {
                                <option value="@occ.Id">[@occ.ContainerCode] @occ.OccurrenceType - @occ.ReportDate.ToString("dd/MM")</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div style="margin-bottom: 35px;">
                <label style="font-weight: 700; color: #795c4d; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px; display: block;">
                    2. Escolher Funcionário
                </label>

                <div style="position: relative;">
                    <i class="fa-solid fa-user-gear" style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #8d6e63;"></i>
                    <select asp-for="SelectedEmployeeId" class="form-select custom-select" style="padding-left: 45px; border-radius: 10px; border: 1px solid #ddd; height: 50px; background-color: #f9f9f9;">
                        <option value="">Delegar tarefa a...</option>
                        @if (Model.Employees != null)
                        {
                            foreach (var emp in Model.Employees)
                            {
                                int count = Model.EmployeeOccurrenceCounts != null && Model.EmployeeOccurrenceCounts.ContainsKey(emp.Id)
                                ? Model.EmployeeOccurrenceCounts[emp.Id] : 0;

                                string carga = count == 0 ? "✅ Livre" : $"⚠️ {count} tarefas ativas";

                                <option value="@emp.Id">@emp.Username (@carga)</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div style="text-align: right;">
                <button type="submit" class="btn-primary" style="padding: 12px 30px; font-size: 1rem; border-radius: 50px; border: none; width: 100%;">
                    <i class="fa-solid fa-paper-plane me-2"></i> Confirmar Atribuição
                </button>
            </div>

        </form>
    </div>
</div>

<style>
    .custom-select:focus {
        border-color: #8d6e63 !important;
        box-shadow: 0 0 0 0.2rem rgba(141, 110, 99, 0.15) !important;
        outline: none;
    }

    .btn-vista-analitica {
        background-color: #e4d4b8;
        color: #795c4d !important;
        padding: 8px 20px;
        border-radius: 50px;
        text-decoration: none !important;
        font-weight: 600;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        border: 2px solid #e4d4b8;
    }

        .btn-vista-analitica:hover {
            background-color: #d6c3a3;
            border-color: #d6c3a3;
            transform: translateY(-2px);
        }
</style>