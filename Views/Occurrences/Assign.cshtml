@model EcoCityWaste.ViewModels.AssignOccurrenceViewModel

@{
    ViewData["Title"] = "Atribuir Ocorrência";
}

@section Styles {
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
}

<div class="page-container">

    <div class="card-box" style="max-width: 900px;">

        <div class="card-title"
             style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">

            <span style="margin:0; font-size:1.5rem; font-weight:bold; color:#8d6e63;">
                Atribuir Ocorrência
            </span>

            <a asp-controller="Admin" asp-action="Dashboard" class="btn-vista-analitica">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </a>

        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success" style="margin-bottom:20px;">
                <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" style="margin-bottom:20px;">
                <i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]
            </div>
        }

        <form asp-action="Assign" method="post">

            <!-- SELECIONAR OCORRÊNCIA -->
            <div class="form-group" style="margin-bottom:20px;">
                <label style="font-weight:600; color:#795c4d;">Selecionar Ocorrência</label>

                <select asp-for="SelectedOccurrenceId" id="occ-select" class="form-control"
                        style="border-radius:10px; padding:12px; border:1px solid #d6c3a3;">
                    <option disabled selected>Escolha uma ocorrência...</option>

                    @foreach (var o in Model.Occurrences)
                    {
                        <option value="@o.Id">
                            #@o.Id — @o.Description
                        </option>
                    }
                </select>
            </div>

            <!-- DETALHES DA OCORRÊNCIA -->
            <div id="occ-details"
                 class="card p-3 shadow-sm"
                 style="display:none; margin-bottom:25px; border-radius:10px; background:#f9f5f3;">
            </div>


            <!-- SELECIONAR FUNCIONÁRIO -->
            <div class="form-group" style="margin-bottom:20px;">
                <label style="font-weight:600; color:#795c4d;">Atribuir a Funcionário</label>

                <select asp-for="SelectedEmployeeId" id="emp-select" class="form-control"
                        style="border-radius:10px; padding:12px; border:1px solid #d6c3a3;">
                    <option disabled selected>Escolha um funcionário...</option>

                    @foreach (var e in Model.Employees)
                    {
                        var count = Model.EmployeeOccurrenceCounts.ContainsKey(e.Id)
                        ? Model.EmployeeOccurrenceCounts[e.Id]
                        : 0;

                        <option value="@e.Id">
                            @e.Username (@count atribuídas)
                        </option>
                    }
                </select>
            </div>

            <!-- DETALHES DO FUNCIONÁRIO -->
            <div id="emp-details"
                 class="card p-3 shadow-sm"
                 style="display:none; margin-bottom:25px; border-radius:10px; background:#f9f5f3;">
            </div>

            <button type="submit"
                    class="btn-primary"
                    style="padding:10px 24px; font-size:1rem; border-radius:50px; display:inline-flex; align-items:center; gap:8px;">
                <i class="fa-solid fa-user-check"></i> Atribuir
            </button>

        </form>

    </div>

</div>

<script>
    // ------------------------------
    // OCORRÊNCIA
    // ------------------------------
    document.getElementById("occ-select").addEventListener("change", function () {
        const id = this.value;

        fetch(`/Occurrences/GetDetails/${id}`)
            .then(res => res.json())
            .then(data => renderOccurrenceDetails(data));
    });

    function renderOccurrenceDetails(data) {
        const box = document.getElementById("occ-details");
        box.style.display = "block";
        box.replaceChildren();

        const title = document.createElement("h5");
        title.textContent = `Ocorrência #${data.id}`;
        title.style.color = "#8d6e63";
        title.style.fontWeight = "bold";
        box.appendChild(title);

        const list = document.createElement("ul");
        list.style.listStyle = "none";
        list.style.padding = "0";

        const fields = [
            ["Tipo", data.occurrenceType],
            ["Contentor", data.containerCode],
            ["Estado", data.status],
            ["Reportada em", data.reportDate],
            ["Reportada por", data.reportedBy],
            ["Descrição", data.description]
        ];

        fields.forEach(([label, value]) => {
            const li = document.createElement("li");
            li.innerHTML = `<strong>${label}:</strong> ${value}`;
            li.style.marginBottom = "4px";
            list.appendChild(li);
        });

        box.appendChild(list);
    }


    // ------------------------------
    // FUNCIONÁRIO
    // ------------------------------
    document.getElementById("emp-select").addEventListener("change", function () {
        const id = this.value;

        fetch(`/Users/GetEmployeeDetails/${id}`)
            .then(res => res.json())
            .then(data => renderEmployeeDetails(data));
    });

        function renderEmployeeDetails(data) {
        const box = document.getElementById("emp-details");
        box.style.display = "block";
        box.replaceChildren();

        const title = document.createElement("h5");
        title.textContent = `Funcionário: ${data.username}`;
        title.style.color = "#8d6e63";
        title.style.fontWeight = "bold";
        box.appendChild(title);

        const list = document.createElement("ul");
        list.style.listStyle = "none";
        list.style.padding = "0";

        const fields = [
            ["Email", data.email],
            ["Ocorrências resolvidas", data.resolvedCount],
            ["Ocorrências por resolver", data.pendingCount]
        ];

        fields.forEach(([label, value]) => {
            const li = document.createElement("li");
            li.innerHTML = `<strong>${label}:</strong> ${value}`;
            li.style.marginBottom = "4px";
            list.appendChild(li);
        });

        box.appendChild(list);
    }
</script>

<style>
    .btn-primary {
        background-color: #8d6e63;
        color: white !important;
        border: none;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background-color: #795c4d;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(141, 110, 99, 0.2);
    }
</style>
