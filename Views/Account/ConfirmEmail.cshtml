@{
    ViewData["Title"] = "Confirmação de Email";
    var success = ViewBag.Success as bool? ?? false;
    var message = ViewBag.Message as string ?? string.Empty;
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                @if (success)
                {
                    <div class="mb-3">
                        <i class="fa fa-check-circle fa-3x text-success"></i>
                    </div>
                    <h4 class="mb-2">Verificação concluída</h4>
                    <p class="text-muted">@message</p>
                    <a class="btn btn-primary mt-3" asp-controller="Account" asp-action="Login">Iniciar Sessão</a>
                    <a class="btn btn-link mt-3" asp-controller="Home" asp-action="Index">Voltar à página inicial</a>
                }
                else
                {
                    <div class="mb-3">
                        <i class="fa fa-exclamation-triangle fa-3x text-danger"></i>
                    </div>
                    <h4 class="mb-2">Verificação falhou</h4>
                    <p class="text-muted">@message</p>
                    <a class="btn btn-primary mt-3" asp-controller="Account" asp-action="Login">Iniciar Sessão</a>
                    <a class="btn btn-link mt-3" asp-controller="Account" asp-action="Verify">Tentar novamente</a>
                }
            </div>
        </div>
    </div>
</div>
