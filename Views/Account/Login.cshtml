@model EcoCityWaste.ViewModels.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EcoCityWaste - Login</title>
    <link rel="stylesheet" href="~/css/login.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body>

    <div class="main-container">
        <div class="left-panel">
            <div class="logo-container">
                <img src="~/img/logo.png" alt="EcoCityWaste Logótipo" class="logo" style="transform: translateX(50px);">
            </div>
        </div>

        <div class="right-panel">
            <div class="auth-box">

                <div class="auth-header">
                    <h1 class="active">Login</h1>
                    <h2 class="inactive">
                        <a asp-controller="Account" asp-action="Register" style="text-decoration:none; color:inherit;">
                            Registar
                        </a>
                    </h2>
                </div>

                @if (ViewBag.Erro != null)
                {
                    <div style="color: red; margin-bottom: 20px; font-weight: 600; text-align: center; background-color: #ffe6e6; padding: 10px; border-radius: 10px;">
                        @ViewBag.Erro
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post">

                    <div style="margin-bottom: 20px;">
                        <label style="font-weight: 700; color: #795c4d; font-size: 0.85rem; text-transform: uppercase; margin-bottom: 8px; display: flex; align-items: center; letter-spacing: 0.5px;">
                            E-mail
                        </label>
                        <div class="input-group" style="margin-bottom: 0;">
                            <i class="fa-solid fa-envelope input-icon"></i>
                            <input asp-for="Email" placeholder="Insira o seu e-mail" required>
                        </div>
                    </div>

                    <div style="margin-bottom: 25px;">
                        <label style="font-weight: 700; color: #795c4d; font-size: 0.85rem; text-transform: uppercase; margin-bottom: 8px; display: flex; align-items: center; letter-spacing: 0.5px;">
                            Palavra-Passe
                            <span title="A sua palavra-passe é encriptada e armazenada de forma segura." style="cursor: help; color: #bcaaa4; margin-left: 8px; font-size: 1rem;">
                                <i class="fa-solid fa-circle-info"></i>
                            </span>
                        </label>
                        <div class="input-group" style="margin-bottom: 0;">
                            <i class="fa-solid fa-key input-icon"></i>
                            <input asp-for="Password" id="password-field" type="password" placeholder="Insira a palavra-passe" required>
                            <i class="fa-solid fa-eye password-toggle" id="togglePassword"></i>
                        </div>
                    </div>

                    <div class="form-footer">
                        <a asp-controller="Account" asp-action="ForgotPassword" class="forgot-password">Esqueceu a palavra-passe?</a>

                        <div class="action-buttons">
                            <a asp-controller="Account" asp-action="LoginGoogle" class="btn-google" title="Entrar com Google">
                                <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" alt="Google Logo">
                            </a>

                            <button type="submit" class="btn-login">Login</button>
                        </div>
                    </div>

                </form>
            </div>
        </div>
    </div>

    <script>
        const togglePassword = document.querySelector('#togglePassword');
        const password = document.querySelector('#password-field');

        togglePassword.addEventListener('click', function (e) {
            const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
            password.setAttribute('type', type);
            this.classList.toggle('fa-eye');
            this.classList.toggle('fa-eye-slash');
        });
    </script>
</body>
</html>