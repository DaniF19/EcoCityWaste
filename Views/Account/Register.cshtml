@model EcoCityWaste.Models.RegisterViewModel
@{
Layout = null;
}

<!DOCTYPE html>

<html lang="pt-pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EcoCityWaste - Registar</title>
    <link rel="stylesheet" href="~/css/login.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>

<div class="main-container">


<!-- LEFT PANEL -->
<div class="left-panel">
    <div class="logo-container">
        <img src="~/img/logo.png"
             alt="EcoCityWaste Logo"
             class="logo"
             style="transform: translateX(50px);" />
    </div>
</div>

<!-- RIGHT PANEL -->
<div class="right-panel">

    <div class="auth-box">

        <!-- HEADER -->
        <div class="auth-header">
            <h2 class="inactive">
                <a asp-controller="Account"
                   asp-action="Login"
                   style="text-decoration:none;color:inherit;">
                    Login
                </a>
            </h2>

            <h1 class="active">Registar</h1>
        </div>

        <!-- VALIDATION SUMMARY -->
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <!-- FORM -->
        <form asp-controller="Account"
              asp-action="Register"
              method="post">

            @Html.AntiForgeryToken()

            <!-- USERNAME -->
            <div class="input-group">
                <i class="fa-solid fa-user input-icon"></i>

                <input asp-for="Username"
                       placeholder="Username"
                       required />

                <span asp-validation-for="Username"
                      class="field-error"></span>
            </div>

            <!-- EMAIL -->
            <div class="input-group">
                <i class="fa-solid fa-envelope input-icon"></i>

                <input asp-for="Email"
                       placeholder="Email"
                       required />

                <span asp-validation-for="Email"
                      class="field-error"></span>
            </div>

            <!-- PASSWORD -->
            <div class="input-group">
                <i class="fa-solid fa-key input-icon"></i>

                <input asp-for="Password"
                       id="password"
                       type="password"
                       placeholder="Palavra-Passe"
                       required />

                <i class="fa-solid fa-eye password-toggle"
                   data-target="password"></i>

                <span asp-validation-for="Password"
                      class="field-error"></span>
            </div>

            <!-- CONFIRM PASSWORD -->
            <div class="input-group">
                <i class="fa-solid fa-key input-icon"></i>

                <input asp-for="ConfirmPassword"
                       id="confirmPassword"
                       type="password"
                       placeholder="Confirmar Palavra-Passe"
                       required />

                <i class="fa-solid fa-eye password-toggle"
                   data-target="confirmPassword"></i>

                <span asp-validation-for="ConfirmPassword"
                      class="field-error"></span>
            </div>

            <!-- FOOTER -->
            <div class="form-footer">

                <a asp-controller="Account"
                   asp-action="Login"
                   class="forgot-password">
                    Já tem conta?
                </a>

                <div class="action-buttons">
                    <button type="submit"
                            class="btn-login">
                        Registar
                    </button>
                </div>
            </div>

        </form>

    </div>
</div>


</div>

<!-- PASSWORD TOGGLE SCRIPT -->

<script>
    document.querySelectorAll(".password-toggle").forEach(toggle => {
        toggle.addEventListener("click", function () {

            const input = document.getElementById(this.dataset.target);

            if (!input) return;

            if (input.type === "password") {
                input.type = "text";
                this.classList.remove("fa-eye");
                this.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                this.classList.remove("fa-eye-slash");
                this.classList.add("fa-eye");
            }
        });
    });
</script>

<!-- VALIDATION SCRIPTS -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>
