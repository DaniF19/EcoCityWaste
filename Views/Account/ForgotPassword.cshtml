@model EcoCityWaste.ViewModels.ForgotPasswordViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recuperar Password - EcoCityWaste</title>
    <link rel="stylesheet" href="~/css/login.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body>
    <div class="main-container">
        <div class="left-panel">
            <div class="logo-container">
                <img src="~/img/logo.png" alt="EcoCityWaste Logo" class="logo" style="transform: translateX(50px);">
            </div>
        </div>

        <div class="right-panel">
            <div class="auth-box">
                <div class="auth-header">
                    <h1 class="active" style="font-size: 2rem;">Recuperar Password</h1>
                </div>

                <hr class="recover-divider" style="margin-top: -10px; margin-bottom: 20px;" />

                <form asp-action="ForgotPassword" method="post">

                    <div style="margin-bottom: 25px;">
                        <label style="font-weight: 700; color: #795c4d; font-size: 0.85rem; text-transform: uppercase; margin-bottom: 8px; display: flex; align-items: center; letter-spacing: 0.5px;">
                            E-mail de Registo
                            <span title="Enviaremos um link para o seu e-mail para poder definir uma nova palavra-passe." style="cursor: help; color: #bcaaa4; margin-left: 8px; font-size: 1rem;">
                                <i class="fa-solid fa-circle-info"></i>
                            </span>
                        </label>
                        <div class="input-group" style="margin-bottom: 0;">
                            <i class="fa-solid fa-envelope input-icon"></i>
                            <input asp-for="Email" type="email" placeholder="Insira o seu e-mail" required />
                        </div>
                    </div>

                    <div class="form-footer">
                        <a asp-controller="Account" asp-action="Login" class="forgot-password">Voltar para o login</a>
                        <div class="action-buttons">
                            <button type="submit" class="btn-login">Enviar Link</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (ViewBag.ShowModal == true)
    {
        <div class="modal-overlay">
            <div class="modal-box">
                <h1 style="color: var(--cor-castanho); font-size: 2rem;">E-mail enviado</h1>
                <hr style="border: 1px solid var(--cor-bege); margin: 20px 0;" />
                <p style="color: #555; margin-bottom: 20px;">
                    Se existir uma conta associada ao e-mail <strong>@Model.Email</strong>, enviámos um link para redefinir a palavra-passe.
                </p>
                <a asp-controller="Account" asp-action="Login" class="btn-login" style="text-decoration: none; display: inline-block;">
                    OK
                </a>
            </div>
        </div>
    }
</body>
</html>