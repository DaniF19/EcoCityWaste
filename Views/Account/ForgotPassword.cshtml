@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar Password";
}

<div class="recover-container">
    <div class="recover-left">
        <img src="~/img/logo.png" alt="EcoCityWaste Logo" />
    </div>

    <div class="recover-right">
        <div class="recover-box">
            <h1>Recuperar Password</h1>
            <hr />

            <p class="recover-text">
                <strong>Insira o email associado à sua conta.</strong><br />
                Será enviado um token para o seu email para validar a sua identidade.
                Após a validação, poderá redefinir a palavra-passe.
            </p>

            <form asp-action="ForgotPassword" method="post">
                <div class="input-group">
                    <input asp-for="Email" placeholder="Email" />
                </div>

                <div class="recover-actions">
                    <a asp-controller="Home" asp-action="Index" class="back-link">Voltar para o login</a>
                    <button type="submit" class="send-btn">Enviar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (ViewBag.ShowModal == true)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <h1>Email enviado</h1>
            <hr />

            <p>
                Se existir uma conta associada a este email,<br />
                foi enviado um link para redefinir a palavra-passe.
            </p>

            <p class="small-text">
                Verifique a sua caixa de entrada (e spam).
            </p>

            <a asp-controller="Home" asp-action="Index" class="send-btn">
                Voltar para o login
            </a>
        </div>
    </div>
}