@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Redefinir Password";
}

<div class="recover-container">
    <div class="recover-left">
        <img src="~/img/logo.png" alt="EcoCityWaste Logo" />
    </div>

    <div class="recover-right">
        <div class="recover-box">
            <h1>Redefinir Password</h1>
            <hr />

            <p class="recover-text">
                <strong>Defina a sua nova palavra-passe.</strong><br />
                Certifique-se de que ambas as palavras-passe coincidem.
            </p>

            <form method="post">
                <input type="hidden" asp-for="Token" />

                <div class="input-group">
                    <input asp-for="NewPassword" type="password" placeholder="Nova palavra-passe" />
                </div>

                <div class="input-group">
                    <input asp-for="ConfirmPassword" type="password" placeholder="Confirmar palavra-passe" />
                </div>

                <div class="recover-actions">
                    <a asp-controller="Home" asp-action="Index" class="back-link">
                        Voltar para o login
                    </a>
                    <button type="submit" class="send-btn">
                        Redefinir
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>