@model ResetPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Redefinir Password";
}

<!DOCTYPE html>
<html lang="pt-pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Redefinir Password - EcoCityWaste</title>
    <link rel="stylesheet" href="~/css/login.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body>

    <div class="main-container">
        <div class="left-panel">
            <div class="logo-container">
                <img src="~/img/logo.png" alt="EcoCityWaste Logo" class="logo" style="transform: translateX(50px);" />
            </div>
        </div>

        <div class="right-panel">
            <div class="auth-box">

                <div class="auth-header">
                    <h1 class="active" style="font-size:2rem;">Nova Palavra-Passe</h1>
                </div>

                <hr class="recover-divider" style="margin-top:-10px;margin-bottom:20px;" />

                <form method="post">
                    <input type="hidden" asp-for="Token" />

                    <div style="margin-bottom: 20px;">
                        <label style="font-weight: 700; color: #795c4d; font-size: 0.85rem; text-transform: uppercase; margin-bottom: 8px; display: flex; align-items: center; letter-spacing: 0.5px;">
                            Nova Palavra-Passe
                            <span title="Lembre-se de utilizar pelo menos 8 caracteres, números e maiúsculas para maior segurança." style="cursor: help; color: #bcaaa4; margin-left: 8px; font-size: 1rem;">
                                <i class="fa-solid fa-circle-info"></i>
                            </span>
                        </label>
                        <div class="input-group" style="margin-bottom: 0;">
                            <i class="fa-solid fa-lock input-icon"></i>
                            <input asp-for="NewPassword" id="newPassword" type="password" placeholder="Defina a nova palavra-passe" required />
                            <i class="fa-solid fa-eye password-toggle" data-target="newPassword"></i>
                        </div>
                        <span asp-validation-for="NewPassword" class="field-error"></span>
                    </div>

                    <div style="margin-bottom: 25px;">
                        <label style="font-weight: 700; color: #795c4d; font-size: 0.85rem; text-transform: uppercase; margin-bottom: 8px; display: flex; align-items: center; letter-spacing: 0.5px;">
                            Confirmar Palavra-Passe
                        </label>
                        <div class="input-group" style="margin-bottom: 0;">
                            <i class="fa-solid fa-lock input-icon"></i>
                            <input asp-for="ConfirmPassword" id="confirmPassword" type="password" placeholder="Repita a nova palavra-passe" required />
                            <i class="fa-solid fa-eye password-toggle" data-target="confirmPassword"></i>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                    </div>

                    <div class="form-footer">
                        <a asp-controller="Home" asp-action="Index" class="forgot-password">Cancelar</a>
                        <div class="action-buttons">
                            <button type="submit" class="btn-login">Redefinir</button>
                        </div>
                    </div>

                </form>
            </div>
        </div>
    </div>

    <script>
        document.querySelectorAll(".password-toggle").forEach(toggle => {
            toggle.addEventListener("click", function () {
                const input = document.getElementById(this.dataset.target);
                if (!input) return;
                if (input.type === "password") {
                    input.type = "text";
                    this.classList.remove("fa-eye");
                    this.classList.add("fa-eye-slash");
                } else {
                    input.type = "password";
                    this.classList.remove("fa-eye-slash");
                    this.classList.add("fa-eye");
                }
            });
        });
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>