@model EcoCityWaste.ViewModels.ResetPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Redefinir Password";
}

<!DOCTYPE html>
<html lang="pt-pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Redefinir Password - EcoCityWaste</title>

    <link rel="stylesheet" href="~/css/login.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body>

<div class="main-container">

    <!-- LEFT PANEL -->
    <div class="left-panel">
        <div class="logo-container">
            <img src="~/img/logo.png"
                 alt="EcoCityWaste Logo"
                 class="logo"
                 style="transform: translateX(50px);" />
        </div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="right-panel">

        <div class="auth-box">

            <div class="auth-header">
                <h1 class="active" style="font-size:2rem;">
                    Redefinir Password
                </h1>
            </div>

            <hr class="recover-divider"
                style="margin-top:-10px;margin-bottom:20px;" />

            <p class="instruction-text">
                <strong>Defina a sua nova palavra-passe.</strong><br />
                Certifique-se de que ambas coincidem.
            </p>

            <form method="post">

                <input type="hidden" asp-for="Token" />

                <!-- NEW PASSWORD -->
                <div class="input-group">
                    <i class="fa-solid fa-lock input-icon"></i>

                    <input asp-for="NewPassword"
                        id="newPassword"
                        type="password"
                        placeholder="Nova palavra-passe"
                        required />

                    <i class="fa-solid fa-eye password-toggle"
                    data-target="newPassword"></i>
                    <span asp-validation-for="NewPassword" class="field-error"></span>
                </div>
                

                <!-- CONFIRM -->
                <div class="input-group">
                    <i class="fa-solid fa-lock input-icon"></i>

                    <input asp-for="ConfirmPassword"
                        id="confirmPassword"
                        type="password"
                        placeholder="Confirmar palavra-passe"
                        required />

                    <i class="fa-solid fa-eye password-toggle"
                    data-target="confirmPassword"></i>
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>
                


                <div class="form-footer">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="forgot-password">
                        Voltar para o login
                    </a>

                    <div class="action-buttons">
                        <button type="submit" class="btn-login">
                            Redefinir
                        </button>
                    </div>
                </div>

            </form>

        </div>

    </div>
</div>

<script>
    document.querySelectorAll(".password-toggle").forEach(toggle => {
        toggle.addEventListener("click", function () {

            const input = document.getElementById(this.dataset.target);

            if (!input) return;

            if (input.type === "password") {
                input.type = "text";
                this.classList.remove("fa-eye");
                this.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                this.classList.remove("fa-eye-slash");
                this.classList.add("fa-eye");
            }
        });
    });
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>
